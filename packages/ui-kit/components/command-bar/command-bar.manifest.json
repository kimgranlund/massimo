{
  "$schema": "../../contracts/component-manifest.schema.json",
  "schemaVersion": 1,
  "name": "command-bar",
  "primary": "component:command-bar",
  "module": "./command-bar.element.ts",
  "registration": "on-import",
  "documentation": "./command-bar.md",
  "examples": "./command-bar.examples.json",
  "contract": "../../contracts/components.json#/components/command-bar",
  "stateContract": "../../contracts/states.json",
  "styleSource": {
    "format": "panda-slot-recipe",
    "module": "./command-bar.recipe.ts"
  },
  "nodes": [
    {
      "id": "component:command-bar",
      "kind": "component",
      "status": "implemented",
      "tag": "ui-command-bar",
      "class": "UICommandBar",
      "extends": "UIElement",
      "intent": [
        "Find and run a command from a searchable modal"
      ],
      "properties": [
        {
          "key": "label",
          "type": "string",
          "default": "Commands",
          "attribute": "label",
          "reflects": false,
          "inspector": {
            "control": "text"
          }
        },
        {
          "key": "open",
          "type": "boolean",
          "default": false,
          "attribute": "open",
          "reflects": true,
          "inspector": {
            "control": "toggle"
          }
        },
        {
          "key": "commands",
          "type": "string",
          "default": null,
          "attribute": "commands",
          "reflects": false,
          "inspector": {
            "control": "text"
          }
        }
      ],
      "attributes": [],
      "events": [
        {
          "name": "openchange",
          "type": "CustomEvent",
          "bubbles": false,
          "cancelable": false,
          "trigger": "openchange happens"
        },
        {
          "name": "select",
          "type": "CustomEvent",
          "bubbles": true,
          "cancelable": false,
          "trigger": "select happens"
        }
      ],
      "semantics": {
        "role": "dialog",
        "formAssociated": false,
        "accessibleName": {
          "sources": [
            "label"
          ],
          "required": true
        }
      },
      "content": {
        "ownership": "component",
        "acceptsChildren": false,
        "children": "Rendered from commands."
      },
      "layout": {
        "display": "contents",
        "sizing": "intrinsic"
      },
      "constraints": [
        "Commands are data: id, label, group, keywords, hint.",
        "Mod+K toggles it.",
        "The highlight wraps."
      ],
      "avoidWhen": [
        {
          "when": "The commands should stay visible.",
          "reason": "A modal hides them.",
          "useInstead": "component:toolbar"
        }
      ],
      "searchTerms": [
        "command bar",
        "command palette",
        "spotlight",
        "quick open"
      ]
    },
    {
      "id": "part:command-bar-list",
      "kind": "part",
      "status": "implemented",
      "tag": "div",
      "selector": "[data-part=list]",
      "summary": "The results."
    },
    {
      "id": "part:command-bar-group",
      "kind": "part",
      "status": "implemented",
      "tag": "div",
      "selector": "[data-part=group]",
      "summary": "A group heading."
    },
    {
      "id": "part:command-bar-item",
      "kind": "part",
      "status": "implemented",
      "tag": "div",
      "selector": "[data-part=item]",
      "summary": "One command."
    },
    {
      "id": "part:command-bar-empty",
      "kind": "part",
      "status": "implemented",
      "tag": "div",
      "selector": "[data-part=empty]",
      "summary": "No results."
    }
  ],
