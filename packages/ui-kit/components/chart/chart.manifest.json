    },
    {
      "from": "component:chart",
      "relation": "allowedIn",
      "to": "context:group"
    },
    {
      "from": "component:chart",
      "relation": "allowedIn",
      "to": "context:form"
    },
    {
      "from": "component:chart",
      "relation": "allowedIn",
      "to": "context:inline"
    }
  ],
  "renderers": {
    "webComponent": {
      "status": "completed",
      "module": "./chart.element.ts",
      "exports": {
        "component:chart": "UIChart"
      },
      "verification": "./verification/chart.verification.json#/renderers/webComponent"
    },
    "react": {
      "status": "completed",
      "module": "./chart.react.tsx",
      "exports": {
        "component:chart": "Chart"
      },
      "verification": "./verification/chart.verification.json#/renderers/react",
      "props": {
        "component:chart": {
          "inherits": [
            "HTMLAttributes<HTMLDivElement>"
          ],
          "props": [
            "label: string",
            "kind?: ChartKind = 'column'",
            "data: ChartData",
            "stacked?: boolean = false",
            "height?: number // Height in px. Default 64u.",
            "locale?: string"
          ]
        }
      }
    }
  }
