      "status": "implemented",
      "tag": "ui-separator",
      "class": "UISeparator",
      "extends": "UIElement",
      "intent": [
        "Divide groups of content in a list, menu, toolbar or panel with a visible rule"
      ],
      "properties": [
        {
          "key": "orientation",
          "type": "string",
          "default": "horizontal",
          "attribute": "orientation",
          "reflects": true,
          "enum": [
            "horizontal",
            "vertical"
          ],
          "description": "horizontal spans the inline axis; vertical stretches across its flex or grid line and needs a row container to have a height.",
          "inspector": {
            "control": "select"
          }
        }
      ],
      "attributes": [],
      "events": [],
      "semantics": {
        "role": "separator",
        "formAssociated": false,
