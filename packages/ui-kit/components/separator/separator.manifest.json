          "required": false
        }
      },
      "content": {
        "ownership": "consumer",
        "acceptsChildren": false,
        "children": "None."
      },
      "layout": {
        "display": "block",
        "sizing": "fill"
      },
      "constraints": [
        "Thickness is max(1px, B), the theme border capped at u/2; color is the border role. It has no margin: the parent's gap spaces it.",
        "Not focusable and has no keyboard behavior; it is a static rule (aria-orientation for assistive technology).",
        "A vertical separator takes its height from its flex or grid line; in block flow it has none."
      ],
      "avoidWhen": [
        {
          "when": "Separating sections of a page with their own headings.",
          "reason": "Headings and the container gap already separate them; a page-level divider is a page style, not a component."
        },
        {
          "when": "Decorating a single surface's edge.",
          "reason": "Use the container's border or a card; a separator divides siblings.",
          "useInstead": "component:container"
        }
      ],
      "searchTerms": [
        "separator",
        "divider",
        "rule",
        "hr",
        "line"
      ]
    }
