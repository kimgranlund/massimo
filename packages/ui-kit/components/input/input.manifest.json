{
  "$schema": "../../contracts/component-manifest.schema.json",
  "schemaVersion": 1,
  "name": "input",
  "primary": "component:input",
  "module": "./input.element.ts",
  "registration": "on-import",
  "documentation": "./input.md",
  "examples": "./input.examples.json",
  "contract": "../../contracts/components.json#/components/input",
  "stateContract": "../../contracts/states.json",
  "styleSource": {
    "format": "panda-slot-recipe",
    "module": "./input.recipe.ts"
  },
  "independentLayers": [
    {
      "kind": "pure-behavior",
      "module": "../../dom/state.ts",
      "exports": [
        "fieldDataAttrs"
      ],
      "description": "The data-* state contract (Base UI names): field state and per-control state maps that both renderers set (React through components/state.react.ts)."
    },
    {
      "kind": "pure-behavior",
      "module": "../../dom/text-entry.ts",
      "exports": [
        "textEntryAttrs",
        "toSingleLine",
        "onTextBeforeInput"
      ],
      "description": "Textbox ARIA, single-line flattening and Enter-to-submit policy for a contenteditable editor."
    },
    {
      "kind": "pure-behavior",
      "module": "../../dom/field.ts",
      "exports": [
        "fieldIds",
        "fieldAttrs"
      ],
      "description": "Label, description and error wiring (ids, aria-labelledby, aria-describedby, aria-invalid); the host's styling state (data-invalid, data-readonly, …) comes from UIFormElement (dom/state.ts)."
    },
    {
      "kind": "geometry",
      "module": "../../tokens/geometry/resolve.ts",
      "exports": [
        "resolveField"
      ],
      "description": "Reference numbers for the field family."
    }
  ],
  "nodes": [
    {
      "id": "component:input",
      "kind": "component",
      "status": "implemented",
      "tag": "ui-input",
      "class": "UIInput",
      "extends": "UIFormElement",
      "intent": [
        "Enter a single line of text",
        "Enter an email address when type is email",
        "Enter a secret when type is password"
      ],
      "properties": [
        {
          "key": "name",
          "type": "string",
          "default": "",
          "attribute": "name",
          "reflects": true,
          "description": "Form field name; the host submits its value under this name. Reflected because the form reads the attribute.",
          "inspector": {
            "control": "text"
          }
        },
        {
          "key": "disabled",
          "type": "boolean",
          "default": false,
          "attribute": "disabled",
          "reflects": true,
          "description": "Blocks interaction and submission. An ancestor <fieldset disabled> has the same effect without setting this property (isDisabled).",
          "inspector": {
            "control": "toggle"
          }
        },
        {
          "key": "required",
          "type": "boolean",
          "default": false,
          "attribute": "required",
          "reflects": true,
          "description": "Requires a value. The error shows only after the user leaves the field or a submit is blocked.",
          "inspector": {
            "control": "toggle"
          }
        },
        {
          "key": "label",
          "type": "string",
          "default": "",
          "attribute": "label",
          "reflects": false,
          "description": "Visible label text; without it supply aria-label on the editor.",
          "inspector": {
            "control": "text"
          }
        },
        {
          "key": "value",
          "type": "string",
          "default": "",
          "attribute": "value",
          "reflects": false,
          "description": "Live value. The value attribute at connect is the reset default.",
          "inspector": {
            "control": "text"
          }
        },
        {
          "key": "defaultValue",
          "type": "string",
          "default": null,
          "attribute": "default-value",
          "reflects": false,
          "description": "Base UI defaultValue: the value at first render (when no value attribute or property set it) and after form reset. Without it, the value attribute is the default, like a native input's.",
          "inspector": {
            "control": "text"
          }
        },
        {
          "key": "type",
          "type": "string",
          "default": "text",
          "attribute": "type",
          "reflects": false,
          "enum": [
            "text",
            "email",
            "password",
            "search",
            "tel",
            "url"
          ],
          "description": "Not reflected. email adds format validation; password masks and blocks copy.",
          "inspector": {
            "control": "select"
          }
        },
        {
          "key": "placeholder",
          "type": "string",
          "default": "",
          "attribute": "placeholder",
          "reflects": false,
          "inspector": {
            "control": "text"
          }
        },
        {
          "key": "description",
          "type": "string",
          "default": "",
          "attribute": "description",
          "reflects": false,
          "inspector": {
            "control": "text"
          }
        },
        {
          "key": "error",
          "type": "string",
          "default": "",
          "attribute": "error",
          "reflects": false,
          "description": "Author error, shown immediately and marking the field invalid.",
          "inspector": {
            "control": "text"
          }
        },
        {
          "key": "readonly",
          "type": "boolean",
          "default": false,
          "attribute": "readonly",
          "reflects": true,
          "inspector": {
            "control": "toggle"
          }
        },
        {
          "key": "minlength",
          "type": "number",
          "default": null,
          "attribute": "minlength",
          "reflects": false,
          "description": "Minimum length; null means no limit.",
          "inspector": {
            "control": "number",
            "min": 0
          }
        },
        {
          "key": "pattern",
          "type": "string",
          "default": "",
          "attribute": "pattern",
          "reflects": false,
          "description": "Regular expression the whole value must match (anchored, v flag).",
          "inspector": {
            "control": "text"
          }
        },
        {
          "key": "labelledby",
          "type": "string",
          "default": "",
          "attribute": "labelledby",
          "reflects": false,
          "description": "Ids (space-separated) that name the editor when label is empty; a wrapping ui-field sets it. Forwarded to the editor's aria-labelledby, so no aria-label on the generic host.",
          "inspector": {
            "control": "text"
          }
        },
        {
          "key": "describedby",
          "type": "string",
          "default": "",
          "attribute": "describedby",
          "reflects": false,
          "description": "Ids (space-separated) that describe the editor, after its own description and error ids; a wrapping ui-field sets it.",
          "inspector": {
            "control": "text"
          }
        }
      ],
      "attributes": [
        {
          "name": "size",
          "type": "number",
          "readBy": "css",
          "description": "Sets the unit u (px) for this element and its subtree: one of the SIZES steps 2…12 (data-size is the same input). Lengths scale from u; type follows 10px + u.",
          "inspector": {
            "control": "number",
            "min": 2,
            "max": 12,
            "step": 0.5
          }
        },
        {
          "name": "hide-label",
          "type": "boolean",
          "readBy": "css",
          "description": "Keeps the label as the control's accessible name but does not draw it (visually hidden, out of flow). For compact layouts that label the control elsewhere, such as an inspector row. data-hide-label is the same input; React: hideLabel.",
          "inspector": {
            "control": "toggle"
          }
        }
      ],
      "events": [
        {
          "name": "input",
          "type": "CustomEvent",
          "bubbles": true,
          "cancelable": false,
          "detail": "{ value: string, reason: 'none', event: InputEvent } (Base UI onValueChange)",
          "trigger": "the text changes while typing (the editor's native input event stops at the editor; it is detail.event)"
        },
        {
          "name": "change",
          "type": "CustomEvent",
          "bubbles": true,
          "cancelable": false,
          "detail": "{ value: string, reason: 'none', event: FocusEvent }",
          "trigger": "focus leaves the editor with a value different from the one it had on focus, like a native input"
        }
      ],
      "methods": [
        {
          "name": "checkValidity",
          "signature": "() => boolean",
          "description": "Runs validation; fires invalid when it fails."
        },
        {
          "name": "reportValidity",
          "signature": "() => boolean",
          "description": "Marks the field touched (errors show) and reports."
        },
        {
          "name": "setCustomValidity",
          "signature": "(message: string) => void",
          "description": "Sets an author error; an empty string clears it."
        },
        {
          "name": "focus",
          "signature": "(options?: FocusOptions) => void",
          "description": "Focuses the editor."
        }
      ],
      "semantics": {
        "role": null,
        "roleTarget": "[data-part=contents] (role=textbox)",
        "formAssociated": true,
        "formValue": "the text value",
        "keyboard": [
          {
            "keys": "Enter",
            "action": "request submit of the owning form"
          }
        ],
        "accessibleName": {
          "sources": [
            "label",
            "aria-label on the editor",
            "labelledby (a wrapping ui-field)"
          ],
          "required": true
        }
      },
      "content": {
        "ownership": "mixed",
        "acceptsChildren": true,
        "children": "Optional adornments with slot=\"leading\" | \"prefix\" | \"suffix\" | \"trailing\"; they move into the control. Other children are discarded by the template."
      },
      "layout": {
        "display": "flex",
        "sizing": "fill"
      },
      "constraints": [
        "template() owns the children: label, control ([leading] [prefix] [editor] [suffix] [trailing]), description, error. Contains no native form elements; form participation goes through ElementInternals (UIFormElement).",
        "The value attribute is the default value used on form reset; the value property is the live value.",
        "Built-in validation (required, email, minlength, pattern) shows only after blur or a blocked submit; error shows at once.",
        "pattern is anchored (^(?:…)$) and compiled with the v flag.",
        "type=password masks the text and blocks copy and cut. Paste is flattened to one line.",
        "focus() moves focus to the editor."
      ],
      "avoidWhen": [
        {
          "when": "Choosing from a known list of values.",
          "reason": "Free text invites typos; Select constrains the value to authored options.",
          "useInstead": "component:select"
        },
        {
          "when": "Entering a number within a range where the exact digit matters less than position.",
          "reason": "Range gives a slider with step, min and max.",
          "useInstead": "component:range"
        },
        {
          "when": "Entering several lines or rich text.",
          "reason": "Input is single-line; Enter submits and pastes are flattened. The kit has no textarea yet."
        }
      ],
      "searchTerms": [
        "input",
        "text field",
        "text input",
        "textbox",
        "email",
        "password",
        "form field"
      ]
    },
    {
      "id": "part:input-control",
      "kind": "part",
      "status": "implemented",
      "tag": "div",
      "selector": ":scope > [data-part=control]",
      "summary": "The field box (pad = u − B) laid out as [leading] [prefix] [editor] [suffix] [trailing]. A press outside the editor focuses it; the focus ring paints here."
    },
    {
      "id": "part:input-editor",
      "kind": "part",
      "status": "implemented",
      "tag": "div",
      "selector": ":scope > [data-part=control] > [data-part=contents]",
      "summary": "The contenteditable role=textbox editor (2u text padding). The editor getter returns it for selection APIs."
    }
  ],
  "edges": [
    {
      "from": "component:input",
      "relation": "extends",
      "to": "foundation:form-element"
    },
