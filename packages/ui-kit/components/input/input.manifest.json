      "status": "in_progress",
      "module": "./input.react.tsx",
      "exports": {
        "component:input": "Input"
      }
    },
    "html": {
      "status": "in_progress",
      "selectors": {
        "component:input": "[data-ui=input]",
        "part:input-control": "[data-ui=input] > [data-part=control]"
      }
    }
