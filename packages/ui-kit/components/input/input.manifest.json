    },
    {
      "from": "component:input",
      "relation": "uses",
      "to": "foundation:modality"
    }
  ],
  "renderers": {
    "webComponent": {
      "status": "completed",
      "module": "./input.element.ts",
      "exports": {
        "component:input": "UIInput"
      },
      "verification": "./verification/input.verification.json#/renderers/webComponent"
    },
    "react": {
      "status": "completed",
      "module": "./input.react.tsx",
      "exports": {
        "component:input": "Input"
      },
      "verification": "./verification/input.verification.json#/renderers/react",
      "props": {
        "component:input": {
          "inherits": [
            "Omit<InputHTMLAttributes<HTMLInputElement>, 'prefix'>"
          ],
          "props": [
            "label?: string",
            "hideLabel?: boolean // Keep the label as the accessible name but do not draw it.",
            "leading?: ReactNode",
            "prefix?: ReactNode",
            "suffix?: ReactNode",
            "trailing?: ReactNode",
            "description?: string",
            "error?: string",
            "onValueChange?: (value: string, details: ChangeDetails) => void // The text changed (Base UI onValueChange; reason 'none'). The native onChange still fires."
          ]
        }
      }
    },
    "html": {
      "status": "in_progress",
      "selectors": {
        "component:input": ".ui-input__root",
        "part:input-control": ".ui-input__control"
      }
    }
  }
}
