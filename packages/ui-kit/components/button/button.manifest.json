    }
  ],
  "renderers": {
    "webComponent": {
      "status": "completed",
      "module": "./button.element.ts",
      "exports": {
        "component:button": "UIButton"
      },
      "verification": "./verification/button.verification.json#/renderers/webComponent"
    },
    "react": {
      "status": "completed",
      "module": "./button.react.tsx",
      "exports": {
        "component:button": "Button"
      },
      "verification": "./verification/button.verification.json#/renderers/react",
      "props": {
        "component:button": {
          "inherits": [
            "Omit<ButtonHTMLAttributes<HTMLButtonElement>, 'prefix'>"
          ],
          "props": [
            "loading?: boolean",
            "variant?: 'neutral' | 'primary' = 'neutral' // primary: the primary solid with contrast text; neutral (default) the muted fill.",
            "leading?: ReactNode",
            "prefix?: ReactNode",
            "suffix?: ReactNode",
            "trailing?: ReactNode",
            "iconSize?: IconSize",
            "size?: number // Unit u in px (2..4.5); control height is 8u."
          ]
        }
      }
    },
    "html": {
      "status": "in_progress",
      "selectors": {
        "component:button": ".ui-button__root"
      }
    }
  }
