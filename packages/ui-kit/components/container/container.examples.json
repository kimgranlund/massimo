{
  "$schema": "../../contracts/examples.schema.json",
  "schemaVersion": 1,
  "component": "container",
  "title": "Containers",
  "summary": "CSS-only layout levels.",
  "defaultExample": "container-nested",
  "examples": [
    {
      "id": "container-nested",
      "label": "ui-container: cards in a card, concentric",
      "subject": "component:container",
      "markup": "<ui-container preset=\"card\" padding=\"xl\"><ui-container preset=\"card\"><strong>Plan</strong><ui-container preset=\"group\"><ui-button>Choose</ui-button><ui-button variant=\"primary\">Buy</ui-button></ui-container></ui-container><ui-container preset=\"card\"><strong>Team</strong><ui-button>Choose</ui-button></ui-container></ui-container>"
    },
    {
      "id": "container-levels",
      "label": "ui-container levels: an even split down to the controls",
      "subject": "component:container",
      "markup": "<ui-container preset=\"card\" padding=\"xl\" levels=\"3\"><ui-container preset=\"card\"><ui-container preset=\"group\"><ui-button>Save</ui-button></ui-container></ui-container></ui-container>"
    },
    {
      "id": "container-presets",
      "label": "ui-container presets",
      "subject": "component:container",
      "markup": "<ui-container preset=\"page\"><ui-container preset=\"panel\"><ui-container preset=\"group\"><ui-button>A</ui-button><ui-button>B</ui-button></ui-container></ui-container><ui-container preset=\"card\" surface=\"raised\"><span>Raised card</span></ui-container></ui-container>"
    },
    {
      "id": "card",
      "label": "Card with a group",
      "subject": "component:card",
      "markup": "<ui-card><span>Title</span><ui-group gap=\"1\"><ui-button>Open</ui-button><ui-button>Share</ui-button></ui-group></ui-card>"
    },
    {
      "id": "card-padding",
      "label": "Card padding xs…xl",
      "subject": "component:card",
      "markup": "<ui-card padding=\"xs\"><span>xs · 2u</span></ui-card><ui-card padding=\"sm\"><span>sm · 3u</span></ui-card><ui-card><span>md · 4u</span></ui-card><ui-card padding=\"lg\"><span>lg · 5u</span></ui-card><ui-card padding=\"xl\"><span>xl · 6u</span></ui-card>"
    },
    {
      "id": "nesting",
      "label": "Nesting",
      "subject": "component:page",
      "markup": "<ui-page><ui-region><ui-panel><ui-card><ui-card padding=\"sm\"><ui-collection><ui-group><ui-badge>1</ui-badge></ui-group></ui-collection></ui-card></ui-card></ui-panel></ui-region></ui-page>"
    },
    {
      "id": "radius-magnitude",
      "label": "Radius magnitude: concentric, half, square",
      "subject": "component:collection",
      "markup": "<ui-collection><ui-button>Concentric</ui-button></ui-collection><ui-collection radius=\"0.5\"><ui-button>Half</ui-button></ui-collection><ui-collection radius=\"0\"><ui-button>Square</ui-button></ui-collection>"
    }
  ]
}
