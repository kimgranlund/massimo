{
  "$schema": "../../contracts/examples.schema.json",
  "schemaVersion": 1,
  "component": "container",
  "title": "Containers",
  "summary": "CSS-only layout levels.",
  "defaultExample": "container-nested",
  "examples": [
    {
      "id": "container-nested",
      "label": "ui-container: cards in a card, concentric",
      "subject": "component:container",
      "markup": "<ui-container preset=\"card\" padding=\"xl\"><ui-section><ui-container preset=\"card\"><ui-section><strong>Plan</strong><ui-container preset=\"group\"><ui-button>Choose</ui-button><ui-button variant=\"primary\">Buy</ui-button></ui-container></ui-section></ui-container><ui-container preset=\"card\"><ui-section><strong>Team</strong><ui-button>Choose</ui-button></ui-section></ui-container></ui-section></ui-container>"
    },
    {
      "id": "container-sections",
      "label": "A card's content sits in sections; a smaller section's text stays level with the title",
      "subject": "component:container",
      "markup": "<ui-container preset=\"card\" padding=\"lg\" radius=\"1.65\"><ui-section header><strong>Card title</strong></ui-section><ui-section size=\"sm\" divided><ui-row>Option 1</ui-row><ui-row>Option 2</ui-row></ui-section></ui-container>"
    },
    {
      "id": "container-presets",
      "label": "ui-container presets",
      "subject": "component:container",
      "markup": "<ui-container preset=\"page\"><ui-container preset=\"panel\"><ui-container preset=\"group\"><ui-button>A</ui-button><ui-button>B</ui-button></ui-container></ui-container><ui-container preset=\"card\" surface=\"raised\"><ui-section><span>Raised card</span></ui-section></ui-container></ui-container>"
    },
    {
      "id": "card",
      "label": "Card with a group",
      "subject": "component:container",
      "markup": "<ui-container preset=\"card\"><ui-section><span>Title</span><ui-container preset=\"group\" gap=\"1\"><ui-button>Open</ui-button><ui-button>Share</ui-button></ui-container></ui-section></ui-container>"
    },
    {
      "id": "card-padding",
      "label": "Card padding xs…xl",
      "subject": "component:container",
      "markup": "<ui-container preset=\"card\" padding=\"xs\"><ui-section><span>xs · 2u</span></ui-section></ui-container><ui-container preset=\"card\" padding=\"sm\"><ui-section><span>sm · 3u</span></ui-section></ui-container><ui-container preset=\"card\"><ui-section><span>md · 4u</span></ui-section></ui-container><ui-container preset=\"card\" padding=\"lg\"><ui-section><span>lg · 6u</span></ui-section></ui-container><ui-container preset=\"card\" padding=\"xl\"><ui-section><span>xl · 8u</span></ui-section></ui-container>"
    },
    {
      "id": "nesting",
      "label": "Nesting",
      "subject": "component:container",
      "markup": "<ui-container preset=\"page\"><ui-container preset=\"region\"><ui-container preset=\"panel\"><ui-container preset=\"card\"><ui-section><ui-container preset=\"card\" padding=\"sm\"><ui-section><ui-container preset=\"collection\"><ui-container preset=\"group\"><ui-badge>1</ui-badge></ui-container></ui-container></ui-section></ui-container></ui-section></ui-container></ui-container></ui-container></ui-container>"
    },
    {
      "id": "radius-magnitude",
      "label": "Radius magnitude: concentric, half, square",
      "subject": "component:container",
      "markup": "<ui-container preset=\"collection\"><ui-button>Concentric</ui-button></ui-container><ui-container preset=\"collection\" radius=\"0.5\"><ui-button>Half</ui-button></ui-container><ui-container preset=\"collection\" radius=\"0\"><ui-button>Square</ui-button></ui-container>"
    }
  ]
}
