      "id": "component:group",
      "kind": "component",
      "status": "implemented",
      "tag": "ui-group",
      "contract": "../../contracts/components.json#/components/group",
      "intent": [
        "Group closely related controls"
      ],
      "properties": [],
      "attributes": [
        {
          "name": "gap",
          "type": "number",
          "readBy": "css",
          "description": "Gutter between children in units of u, 0…8 in 0.5 steps. Default: the container level's padding.",
          "inspector": {
            "control": "number",
            "min": 0,
            "max": 8,
            "step": 0.5
          }
        },
        {
          "name": "size",
          "type": "number",
          "readBy": "css",
          "description": "Sets the unit u (px) for this element and its subtree: one of the SIZES steps 2…12 (data-size is the same input). Lengths scale from u; type follows 10px + u.",
          "inspector": {
            "control": "number",
            "min": 2,
            "max": 12,
            "step": 0.5
          }
        }
      ],
      "events": [],
      "semantics": {
        "role": null,
        "formAssociated": false
      },
      "content": {
        "ownership": "consumer",
        "acceptsChildren": true,
        "children": "Any flow content."
      },
      "layout": {
        "display": "inline-flex",
        "sizing": "intrinsic"
      },
      "constraints": [
        "CSS-only tag: no script, nothing to register. 1u padding, radius up to 4u.",
        "Gap defaults to the level padding; gap overrides it. Adds no role: add role/aria-label (e.g. role=region) when it should be a landmark or group."
      ],
      "avoidWhen": [
        {
          "when": "Exclusive selection among the grouped buttons.",
          "reason": "A group only spaces its children.",
          "useInstead": "component:segmented"
        }
      ],
      "searchTerms": [
        "group",
        "group container",
        "container",
        "layout"
      ]
