  "nodes": [
    {
      "id": "component:container",
      "kind": "component",
      "status": "implemented",
      "tag": "ui-container",
      "contract": "../../contracts/components.json#/components/container",
      "intent": [
        "Hold content at any level, from a group of controls to a whole page, with one element whose radius and padding nest concentrically: a nested container takes its parent's radius minus its padding, so every curve down to the controls follows the outer one"
      ],
      "properties": [],
      "attributes": [
        {
          "name": "preset",
          "type": "string",
          "readBy": "css",
          "description": "The starting geometry, flow and surface: group (a wrapping row, 1u), collection (a stack, 2u; the default), card (a card surface, 4u), panel (the panel fill, square), region (square, 8u), page (square, 8u, a centered 72rem column).",
          "enum": [
            "group",
            "collection",
            "card",
            "panel",
            "region",
            "page"
          ],
          "inspector": {
            "control": "select"
          }
        },
        {
          "name": "padding",
          "type": "string",
          "readBy": "css",
          "description": "The card ladder level, xs 2u, sm 3u, md 4u, lg 5u, xl 6u; replaces the preset level.",
          "enum": [
            "xs",
            "sm",
            "md",
            "lg",
            "xl"
          ],
          "inspector": {
            "control": "select"
          }
        },
        {
          "name": "layout",
          "type": "string",
          "readBy": "css",
          "description": "stack (a column), row (one line), wrap (a wrapping row). Default: the preset's.",
          "enum": [
            "stack",
            "row",
            "wrap"
          ],
          "inspector": {
            "control": "select"
          }
        },
        {
          "name": "surface",
          "type": "string",
          "readBy": "css",
          "description": "none, panel, card, raised: the elevation level (fill and shadow). Default: the preset's.",
          "enum": [
            "none",
            "panel",
            "card",
            "raised"
          ],
          "inspector": {
            "control": "select"
          }
        },
        {
          "name": "levels",
          "type": "number",
          "readBy": "css",
          "description": "On a root: the nested levels below it. The padding splits evenly, (R − control radius) / levels, so every curve down to the controls is concentric.",
          "inspector": {
            "control": "number",
            "min": 1,
            "max": 6,
            "step": 1
          }
        },
        {
          "name": "gap",
          "type": "number",
          "readBy": "css",
          "description": "Gutter between children in units of u, 0…8 in 0.5 steps. Default: the container level's padding.",
          "inspector": {
            "control": "number",
            "min": 0,
            "max": 8,
            "step": 0.5
          }
        },
        {
          "name": "radius",
          "type": "number",
          "readBy": "css",
          "description": "Radius as a magnitude of the concentric radius, 0…1 in 0.05 steps: 1 concentric (default: the theme's radius-card), 0 square. Lets the container be sharper than fully rounded contents.",
          "inspector": {
            "control": "number",
            "min": 0,
            "max": 1,
            "step": 0.05
          }
        },
        {
          "name": "size",
          "type": "number",
          "readBy": "css",
          "description": "Sets the unit u (px) for this element and its subtree: one of the SIZES steps 2…12 (data-size is the same input). Lengths scale from u; type follows 10px + u.",
          "inspector": {
            "control": "number",
            "min": 2,
            "max": 12,
            "step": 0.5
          }
        }
      ],
      "events": [],
      "semantics": {
        "role": null,
        "formAssociated": false
      },
      "content": {
        "ownership": "consumer",
        "acceptsChildren": true,
        "children": "Any flow content."
      },
      "layout": {
        "display": "flex",
        "sizing": "fill"
      },
      "constraints": [
        "CSS-only tag: no script, nothing to register. preset (group, collection, card, panel, region, page) sets the starting geometry, flow and surface; layout and surface override it.",
        "Nesting: a root keeps its preset geometry; a nested ui-container is concentric with its parent (R = R_parent − p_parent); a container holding containers keeps the ratio (container-ratio) for them, or splits evenly with levels; a leaf fits its controls. Areas (panel, region, page) are square and restart the chain. Up to 6 levels.",
        "Adds no role: add role/aria-label (e.g. role=region) when it should be a landmark or group."
      ],
      "avoidWhen": [
        {
          "when": "Exclusive selection among grouped buttons.",
          "reason": "A container only lays out and nests its children.",
          "useInstead": "component:segmented"
        }
      ],
      "searchTerms": [
        "container",
        "universal container",
        "card",
        "group",
        "collection",
        "panel",
        "region",
        "page",
        "surface",
        "nesting",
        "concentric",
        "layout",
        "stack"
      ]
    },
