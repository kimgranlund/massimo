  "renderers": {
    "webComponent": {
      "status": "completed",
      "documentation": "./flow.md",
      "verification": "./verification/flow.verification.json#/renderers/webComponent"
    },
    "react": {
      "status": "completed",
      "module": "./flow.react.tsx",
      "exports": {
        "component:column": "Column",
        "component:list": "List",
        "component:grid": "Grid"
      },
      "verification": "./verification/flow.verification.json#/renderers/react",
      "props": {
        "component:column": {
          "inherits": [
            "HTMLAttributes<HTMLDivElement>"
          ],
          "props": [
            "gap?: number // Gutter between children in units of u, 0 … 8 in 0.5 steps. Default 2.",
            "align?: Align // Cross-axis alignment. Default: stretch."
          ]
        },
        "component:list": {
          "inherits": [
            "HTMLAttributes<HTMLUListElement>"
          ],
          "props": [
            "gap?: number // Gutter between items in units of u, 0 … 8 in 0.5 steps. Default 2.",
            "align?: Align // Cross-axis alignment. Default: stretch."
          ]
        },
        "component:grid": {
          "inherits": [
            "HTMLAttributes<HTMLDivElement>"
          ],
          "props": [
            "gap?: number // Gutter between tiles in units of u, 0 … 8 in 0.5 steps. Default 2.",
            "columns?: GridColumns // A fixed column count. Default: as many tiles as fit `min`.",
            "min?: GridMin // The smallest tile width: sm 40u, md 60u, lg 80u. Default md."
          ]
        }
      }
    }
