          "inspector": {
            "control": "number",
            "min": 2,
            "max": 12,
            "step": 0.5
          }
        }
      ],
      "events": [
        {
          "name": "input",
          "type": "Event",
          "bubbles": true,
          "cancelable": false,
          "trigger": "user changes the value"
        },
        {
          "name": "change",
          "type": "Event",
          "bubbles": true,
          "cancelable": false,
          "trigger": "user commits a new value"
        }
      ],
      "methods": [
        {
          "name": "checkValidity",
          "signature": "() => boolean",
          "description": "Runs validation; fires invalid when it fails."
        },
        {
          "name": "reportValidity",
          "signature": "() => boolean",
          "description": "Marks the field touched (errors show) and reports."
        },
        {
          "name": "setCustomValidity",
          "signature": "(message: string) => void",
          "description": "Sets an author error; an empty string clears it."
        },
        {
          "name": "select",
          "signature": "(focus?: boolean) => void",
          "description": "Checks this radio, unchecks its group, optionally focuses it."
        }
      ],
      "semantics": {
        "role": "radio",
        "formAssociated": true,
        "formValue": "value of the checked radio in the group",
        "keyboard": [
          {
            "keys": "Space",
            "action": "select"
          },
          {
            "keys": "ArrowDown, ArrowRight / ArrowUp, ArrowLeft",
            "action": "move to and select the next / previous radio (wraps)"
          }
        ],
        "accessibleName": {
          "sources": [
            "contents text",
            "aria-label"
          ],
          "required": true
        }
      },
      "content": {
        "ownership": "mixed",
        "acceptsChildren": true,
        "children": "Label text and optional slot=\"prefix\" | \"suffix\" adornments; the indicator is added to the leading slot."
      },
      "layout": {
        "display": "inline-flex",
        "sizing": "intrinsic"
      },
      "constraints": [
        "Radios group by name within their form, or the document when outside a form; there is no group element. Contains no native form elements; form participation goes through ElementInternals (UIFormElement).",
        "Roving tab stop: only the checked radio (or the first enabled one) is tabbable.",
        "required on any member makes the whole group required.",
        "Wrap the group in an element with role=radiogroup and a label for an accessible group name."
      ],
      "avoidWhen": [
        {
          "when": "Several options may be chosen.",
          "reason": "Radios allow only one.",
          "useInstead": "component:checkbox"
        },
        {
          "when": "More than about seven options.",
          "reason": "A long radio list is hard to scan; Select collapses it.",
          "useInstead": "component:select"
        },
        {
          "when": "Switching views or modes in place.",
          "reason": "Segmented is the compact single-select for views.",
          "useInstead": "component:segmented"
        }
      ],
      "searchTerms": [
        "radio",
        "radio button",
        "radio group",
        "single choice"
      ],
      "contract": "../../contracts/components.json#/components/radio"
    },
