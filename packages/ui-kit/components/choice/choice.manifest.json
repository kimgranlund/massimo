    {
      "id": "component:checkbox",
      "kind": "component",
      "status": "implemented",
      "tag": "ui-checkbox",
      "class": "UICheckbox",
      "extends": "UIFormElement",
      "intent": [
        "Turn one independent option on or off",
        "Accept a statement such as terms when required"
      ],
      "properties": [
        {
          "key": "name",
          "type": "string",
          "default": "",
          "attribute": "name",
          "reflects": true,
          "description": "Form field name; the host submits its value under this name. Reflected because the form reads the attribute.",
          "inspector": {
            "control": "text"
          }
        },
        {
          "key": "disabled",
          "type": "boolean",
          "default": false,
          "attribute": "disabled",
          "reflects": true,
          "description": "Blocks interaction and submission. An ancestor <fieldset disabled> has the same effect without setting this property (isDisabled).",
          "inspector": {
            "control": "toggle"
          }
        },
        {
          "key": "required",
          "type": "boolean",
          "default": false,
          "attribute": "required",
          "reflects": true,
          "description": "Must be checked to submit.",
          "inspector": {
            "control": "toggle"
          }
        },
        {
          "key": "checked",
          "type": "boolean",
          "default": false,
          "attribute": "checked",
          "reflects": false,
          "description": "Live state; not reflected. The checked attribute at connect is the reset default.",
          "inspector": {
            "control": "toggle"
          }
        },
        {
          "key": "value",
          "type": "string",
          "default": "on",
          "attribute": "value",
          "reflects": false,
          "description": "Submitted when checked (default \"on\").",
          "inspector": {
            "control": "text"
          }
        },
        {
          "key": "indeterminate",
          "type": "boolean",
          "default": false,
          "attribute": "indeterminate",
          "reflects": true,
          "description": "Shows mixed (aria-checked=mixed); cleared on user activation.",
          "inspector": {
            "control": "toggle"
          }
        }
      ],
      "attributes": [
        {
          "name": "size",
          "type": "number",
          "readBy": "css",
          "description": "Sets the unit u (px) for this element and its subtree: one of the SIZES steps 2…12 (data-size is the same input). Lengths scale from u; type follows 10px + u.",
          "inspector": {
            "control": "number",
            "min": 2,
            "max": 12,
            "step": 0.5
          }
        }
      ],
      "events": [
        {
          "name": "input",
          "type": "Event",
          "bubbles": true,
          "cancelable": false,
          "trigger": "user changes the value"
        },
        {
          "name": "change",
          "type": "Event",
          "bubbles": true,
          "cancelable": false,
          "trigger": "user commits a new value"
        }
      ],
      "methods": [
        {
          "name": "checkValidity",
          "signature": "() => boolean",
          "description": "Runs validation; fires invalid when it fails."
        },
        {
          "name": "reportValidity",
          "signature": "() => boolean",
          "description": "Marks the field touched (errors show) and reports."
        },
        {
          "name": "setCustomValidity",
          "signature": "(message: string) => void",
          "description": "Sets an author error; an empty string clears it."
        }
      ],
      "semantics": {
        "role": "checkbox",
        "formAssociated": true,
        "formValue": "value when checked; nothing when unchecked",
        "keyboard": [
          {
            "keys": "Space",
            "action": "toggle"
          }
        ],
        "accessibleName": {
          "sources": [
            "contents text",
            "aria-label"
          ],
          "required": true
        }
      },
      "content": {
        "ownership": "mixed",
        "acceptsChildren": true,
        "children": "Label text and optional slot=\"prefix\" | \"suffix\" adornments; the indicator is added to the leading slot."
      },
      "layout": {
        "display": "inline-flex",
        "sizing": "intrinsic"
      },
      "constraints": [
        "The host is the control: role=checkbox, aria-checked true | false | mixed, tabindex 0. Contains no native form elements; form participation goes through ElementInternals (UIFormElement).",
        "indeterminate shows mixed and clears when the user toggles.",
        "The checked attribute at connect is the reset default; checked is not reflected.",
        "Box radius is 1u."
      ],
      "avoidWhen": [
        {
          "when": "Choosing exactly one option from a mutually exclusive set.",
          "reason": "Independent checkboxes allow several checked at once.",
          "useInstead": "component:radio"
        },
        {
          "when": "A setting that takes effect immediately, without a submit.",
          "reason": "Switch communicates an instant on/off.",
          "useInstead": "component:switch"
        }
      ],
      "searchTerms": [
        "checkbox",
        "check box",
        "tick",
        "accept terms",
        "multi select"
      ]
    },
