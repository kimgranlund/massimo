      "relation": "usesTokens",
      "to": "tokens:geometry"
    }
  ],
  "renderers": {
    "webComponent": {
      "status": "completed",
      "documentation": "./section.md",
      "verification": "./verification/section.verification.json#/renderers/webComponent"
    },
    "react": {
      "status": "completed",
      "module": "./section.react.tsx",
      "exports": {
        "component:section": "Section"
      },
      "verification": "./verification/section.verification.json#/renderers/react",
      "props": {
        "component:section": {
          "inherits": [
            "HTMLAttributes<HTMLDivElement>"
          ],
          "props": [
            "size?: CardPadding // The padding this section supplies, xs 2u … xl 8u. It sits the rest of the card's inset in from the edge, so its text stays on the card's inset. Default: all of it.",
            "divided?: boolean // Full-bleed rows with lines between them, outlined when the section has a size.",
            "header?: boolean | 'collapse' // A title row: a divided row's height. `collapse` makes its lower half a margin, so the next section's top stays put at every size."
          ]
        }
      }
    }
