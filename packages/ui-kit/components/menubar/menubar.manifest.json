  "renderers": {
    "webComponent": {
      "status": "completed",
      "module": "./menubar.element.ts",
      "exports": {
        "component:menubar": "UIMenubar"
      },
      "verification": "./verification/menubar.verification.json#/renderers/webComponent"
    },
    "react": {
