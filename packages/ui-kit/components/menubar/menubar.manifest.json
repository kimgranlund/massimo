      },
      "verification": "./verification/menubar.verification.json#/renderers/react",
      "props": {
        "component:menubar": {
          "inherits": [
            "Omit<HTMLAttributes<HTMLDivElement>, 'className'>"
          ],
          "props": [
            "render?: RenderProp // Replace the part's element (Base UI render): an element (the part's props merge into it) or `(props, state) => element`. The recipe class and data-* stay on whatever renders.",
            "className?: string | ((state: PartState) => string | undefined) // Author class, or a function of the part's state (Base UI className); added after the recipe class.",
            "orientation?: 'horizontal' | 'vertical' = 'horizontal' // horizontal (default) or vertical: the bar's direction, its keys and where its menus open.",
            "label?: string // Accessible name of the bar.",
            "size?: number // Unit u in px; the bar is 8u, its triggers 7u.",
            "children?: ReactNode"
          ]
        }
      }
