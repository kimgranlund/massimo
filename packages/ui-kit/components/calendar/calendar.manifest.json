  "documentation": "./calendar.md",
  "examples": "./calendar.examples.json",
  "contract": "../../contracts/components.json#/components/calendar",
  "stateContract": "../../contracts/states.json",
  "styleSource": {
    "format": "panda-slot-recipe",
    "module": "./calendar.recipe.ts"
  },
  "nodes": [
    {
      "id": "component:calendar",
      "kind": "component",
      "status": "implemented",
      "tag": "ui-calendar",
      "class": "UICalendar",
      "extends": "UIFormElement",
      "intent": [
        "Choose one date or an inclusive range from an always-visible month grid"
      ],
      "properties": [
        {
          "key": "name",
          "type": "string",
          "default": "",
          "attribute": "name",
          "reflects": true,
          "inspector": {
            "control": "text"
          }
        },
        {
          "key": "disabled",
          "type": "boolean",
          "default": false,
          "attribute": "disabled",
          "reflects": true,
          "inspector": {
            "control": "toggle"
          }
        },
        {
          "key": "required",
          "type": "boolean",
          "default": false,
          "attribute": "required",
          "reflects": true,
          "inspector": {
            "control": "toggle"
          }
        },
        {
          "key": "value",
          "type": "string",
          "default": "",
          "attribute": "value",
          "reflects": false,
          "inspector": {
            "control": "text"
          }
        },
        {
          "key": "min",
          "type": "string",
          "default": "",
          "attribute": "min",
          "reflects": false,
          "inspector": {
            "control": "text"
          }
        },
        {
          "key": "max",
          "type": "string",
          "default": "",
          "attribute": "max",
          "reflects": false,
          "inspector": {
            "control": "text"
          }
        },
        {
          "key": "locale",
          "type": "string",
          "default": "",
          "attribute": "locale",
          "reflects": false,
          "inspector": {
            "control": "text"
          }
        },
        {
          "key": "mode",
          "type": "string",
          "default": "single",
          "attribute": "mode",
          "reflects": false,
          "inspector": {
            "control": "text"
          }
        },
        {
          "key": "label",
          "type": "string",
          "default": "Choose a date",
          "attribute": "label",
          "reflects": false,
          "inspector": {
            "control": "text"
          }
        }
      ],
      "attributes": [],
      "events": [
        {
          "name": "change",
          "type": "CustomEvent",
          "bubbles": true,
          "cancelable": false,
          "trigger": "the user commits a new value"
        }
      ],
      "semantics": {
        "role": "grid",
        "formAssociated": true,
        "accessibleName": {
          "sources": [
            "label"
          ],
          "required": true
        }
      },
      "content": {
        "ownership": "component",
        "acceptsChildren": false,
        "children": "Rendered from value, min, max and locale."
      },
      "layout": {
        "display": "inline-flex",
        "sizing": "intrinsic"
      },
      "constraints": [
        "Values are ISO dates; a range is start/end.",
        "Names come from Intl, following locale.",
        "Dates are computed in UTC, so a time zone can't shift a day.",
        "Only the focused day is a tab stop."
      ],
      "avoidWhen": [
        {
          "when": "The calendar should open from a field.",
          "reason": "The grid takes a lot of room.",
          "useInstead": "component:date-picker"
        }
      ],
      "searchTerms": [
        "calendar",
        "month grid",
        "date grid",
        "day picker"
      ]
    },
    {
      "id": "part:calendar-header",
      "kind": "part",
      "status": "implemented",
      "tag": "div",
      "selector": ":scope > [data-part=header]",
      "summary": "Month title and buttons."
    },
    {
      "id": "part:calendar-title",
      "kind": "part",
      "status": "implemented",
      "tag": "span",
      "selector": "[data-part=title]",
      "summary": "The month and year."
    },
    {
      "id": "part:calendar-grid",
      "kind": "part",
      "status": "implemented",
      "tag": "div",
      "selector": ":scope > [data-part=grid]",
      "summary": "The grid."
    },
    {
      "id": "part:calendar-row",
      "kind": "part",
      "status": "implemented",
      "tag": "div",
      "selector": "[data-part=row]",
      "summary": "One week."
    },
    {
      "id": "part:calendar-weekday",
      "kind": "part",
      "status": "implemented",
      "tag": "span",
      "selector": "[data-part=weekday]",
      "summary": "A column header."
    },
    {
      "id": "part:calendar-cell",
      "kind": "part",
      "status": "implemented",
      "tag": "span",
      "selector": "[data-part=cell]",
      "summary": "One day."
    }
