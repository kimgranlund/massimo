      "id": "component:listbox",
      "kind": "component",
      "status": "implemented",
      "tag": "ui-listbox",
      "class": "UIListbox",
      "extends": "UIFormElement",
      "intent": [
        "Choose one value from a list that stays visible"
      ],
      "properties": [
        {
          "key": "name",
          "type": "string",
          "default": "",
          "attribute": "name",
          "reflects": true,
          "description": "Form field name; the host submits its value under this name. Reflected because the form reads the attribute.",
          "inspector": {
            "control": "text"
          }
        },
        {
          "key": "disabled",
          "type": "boolean",
          "default": false,
          "attribute": "disabled",
          "reflects": true,
          "description": "Blocks interaction and submission. An ancestor <fieldset disabled> has the same effect without setting this property (isDisabled).",
          "inspector": {
            "control": "toggle"
          }
        },
        {
          "key": "required",
          "type": "boolean",
          "default": false,
          "attribute": "required",
          "reflects": true,
          "description": "Requires a value. The error shows only after the user leaves the field or a submit is blocked.",
          "inspector": {
            "control": "toggle"
          }
        },
        {
          "key": "value",
          "type": "string",
          "default": "",
          "attribute": "value",
          "reflects": false,
          "description": "The selected option value. The value attribute at connect is the reset default.",
          "inspector": {
            "control": "text"
          }
        },
        {
          "key": "orientation",
          "type": "string",
          "default": "vertical",
          "attribute": "orientation",
          "reflects": true,
          "enum": [
            "vertical",
            "horizontal"
          ],
          "description": "Arrow-key axis and layout direction.",
          "inspector": {
            "control": "select"
          }
        },
        {
          "key": "label",
          "type": "string",
          "default": "",
          "attribute": "label",
          "reflects": false,
          "inspector": {
            "control": "text"
          }
        }
      ],
      "attributes": [
        {
          "name": "size",
          "type": "number",
          "readBy": "css",
          "description": "Sets the unit u (px) for this element and its subtree: one of the SIZES steps 2…12 (data-size is the same input). Lengths scale from u; type follows 10px + u.",
          "inspector": {
            "control": "number",
            "min": 2,
            "max": 12,
            "step": 0.5
          }
        },
        {
          "name": "gap",
          "type": "number",
          "readBy": "css",
          "description": "Gutter between children in units of u, 0…8 in 0.5 steps. Default: the container level's padding.",
          "inspector": {
            "control": "number",
            "min": 0,
            "max": 8,
            "step": 0.5
          }
        }
      ],
      "events": [
        {
          "name": "input",
          "type": "Event",
          "bubbles": true,
          "cancelable": false,
          "trigger": "user changes the value"
        },
        {
          "name": "change",
          "type": "Event",
          "bubbles": true,
          "cancelable": false,
          "trigger": "user commits a new value"
        }
      ],
      "methods": [
        {
          "name": "checkValidity",
          "signature": "() => boolean",
          "description": "Runs validation; fires invalid when it fails."
        },
        {
          "name": "reportValidity",
          "signature": "() => boolean",
          "description": "Marks the field touched (errors show) and reports."
        },
        {
          "name": "setCustomValidity",
          "signature": "(message: string) => void",
          "description": "Sets an author error; an empty string clears it."
        }
      ],
      "semantics": {
        "role": "listbox",
        "formAssociated": true,
        "formValue": "the selected option value",
        "keyboard": [
          {
            "keys": "ArrowUp, ArrowDown (vertical) / ArrowLeft, ArrowRight (horizontal)",
            "action": "move and select"
          },
          {
            "keys": "Home, End",
            "action": "first / last enabled option"
          },
          {
            "keys": "printable characters",
            "action": "typeahead"
          }
        ],
        "accessibleName": {
          "sources": [
            "label",
            "aria-label",
            "aria-labelledby"
          ],
          "required": true
        }
      },
      "content": {
        "ownership": "consumer",
        "acceptsChildren": true,
        "children": "ui-option elements (direct children)."
      },
      "layout": {
        "display": "flex",
        "sizing": "fill"
      },
      "constraints": [
        "The host is the listbox and the single tab stop; aria-activedescendant tracks the highlighted option. Contains no native form elements; form participation goes through ElementInternals (UIFormElement).",
        "Selection follows focus: moving the highlight selects and fires input and change.",
        "Only direct ui-option children count; disabled options are skipped."
      ],
      "avoidWhen": [
        {
          "when": "Space is tight and the choice is made rarely.",
          "reason": "A listbox takes room for every option; Select collapses into one field.",
          "useInstead": "component:select"
        },
        {
          "when": "Choosing several values.",
          "reason": "Single select only.",
          "useInstead": "component:checkbox"
        },
        {
          "when": "A list of navigation links or commands.",
          "reason": "Options are values, not actions; selection follows focus would trigger navigation on arrow keys. Use buttons or links.",
          "useInstead": "component:button"
        }
      ],
      "searchTerms": [
        "listbox",
        "list select",
        "option list",
        "single select list"
      ]
    },
