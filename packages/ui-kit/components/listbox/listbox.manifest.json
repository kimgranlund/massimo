            "leading?: ReactNode // Leading icon (an <i name> or artwork).",
            "prefix?: ReactNode // Short text adornment before the label.",
            "suffix?: ReactNode // Short text adornment after the label.",
            "trailing?: ReactNode // Trailing icon.",
            "value: string // Submitted value.",
            "disabled?: boolean",
            "iconSize?: IconSize",
            "children?: ReactNode"
          ]
        }
      }
    }
  }
}
