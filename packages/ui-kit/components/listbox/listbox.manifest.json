        "acceptsChildren": true,
        "children": "Label text, icons and adornments; children move into leading / prefix / contents / suffix / trailing parts."
      },
      "layout": {
        "display": "flex",
        "sizing": "fill"
      },
      "constraints": [
        "The owning list sets role=option, id, aria-selected, aria-disabled and data-active; the option sets none itself.",
        "optionValue is the value attribute, else the contents text (icons excluded).",
        "Only a direct child of ui-listbox, ui-segmented or ui-select (ui-select moves it into its popup)."
      ],
      "avoidWhen": [
