{
  "$schema": "../../contracts/component-manifest.schema.json",
  "schemaVersion": 1,
  "name": "kbd",
  "primary": "component:kbd",
  "module": "./kbd.element.ts",
  "registration": "on-import",
  "documentation": "./kbd.md",
  "examples": "./kbd.examples.json",
  "contract": "../../contracts/components.json#/components/kbd",
  "stateContract": "../../contracts/states.json",
  "styleSource": {
    "format": "panda-slot-recipe",
    "module": "./kbd.recipe.ts"
  },
  "nodes": [
    {
      "id": "component:kbd",
      "kind": "component",
      "status": "implemented",
      "tag": "ui-kbd",
      "class": "UIKbd",
      "extends": "UIElement",
      "intent": [
        "Show keys and keyboard shortcuts"
      ],
      "properties": [
        {
          "key": "keys",
          "type": "string",
          "default": "",
          "attribute": "keys",
          "reflects": false,
          "inspector": {
            "control": "text"
          }
        },
        {
          "key": "platform",
          "type": "string",
          "default": "auto",
          "attribute": "platform",
          "reflects": false,
          "inspector": {
            "control": "text"
          }
        }
      ],
      "attributes": [],
      "events": [],
      "semantics": {
        "role": null,
        "formAssociated": false,
        "accessibleName": {
          "sources": [
            "the spoken key names"
          ],
          "required": false
        }
      },
      "content": {
        "ownership": "component",
        "acceptsChildren": true,
        "children": "Text content is the keys input for a single key."
      },
      "layout": {
        "display": "inline-flex",
        "sizing": "intrinsic"
      },
      "constraints": [
        "Notation only: it registers no shortcut and takes no focus.",
        "Assistive technology reads the key names, not the symbols.",
        "Density doesn't change the cap."
      ],
      "avoidWhen": [
        {
          "when": "The user acts by pressing it on screen.",
          "reason": "A kbd is passive.",
          "useInstead": "component:button"
        },
        {
          "when": "A short status or count.",
          "reason": "A kbd only names keys.",
          "useInstead": "component:badge"
        }
      ],
      "searchTerms": [
        "kbd",
        "keyboard",
        "shortcut",
        "hotkey",
        "key cap",
        "keycap",
        "command key"
      ]
    },
    {
      "id": "part:kbd-keys",
      "kind": "part",
      "status": "implemented",
      "tag": "span",
      "selector": ":scope > [data-part=keys]",
      "summary": "The row of caps, hidden from assistive technology."
    },
    {
      "id": "part:kbd-cap",
      "kind": "part",
      "status": "implemented",
      "tag": "span",
      "selector": ":scope > [data-part=keys] > [data-part=cap]",
      "summary": "One key."
    },
    {
      "id": "part:kbd-label",
      "kind": "part",
      "status": "implemented",
      "tag": "span",
      "selector": ":scope > [data-part=label]",
      "summary": "The visually hidden spoken key names."
    }
  ],
