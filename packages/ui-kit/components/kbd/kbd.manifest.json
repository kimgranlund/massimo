      "verification": "./verification/kbd.verification.json#/renderers/react",
      "props": {
        "component:kbd": {
          "inherits": [
            "Omit<HTMLAttributes<HTMLElement>, 'children'>"
          ],
          "props": [
            "keys: string // Keys joined with +, such as mod+shift+p. mod is Command on a Mac and Control elsewhere.",
            "platform?: 'auto' | KbdPlatform = 'auto' // auto follows the viewer's platform.",
            "size?: number // Unit u in px for this element."
          ]
        }
      }
