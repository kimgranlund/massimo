{
  "$schema": "../../contracts/examples.schema.json",
  "schemaVersion": 1,
  "component": "kbd",
  "title": "Kbd",
  "summary": "Keys and keyboard shortcuts shown as caps.",
  "defaultExample": "shortcut",
  "examples": [
    {
      "id": "key",
      "label": "A single key",
      "subject": "component:kbd",
      "markup": "<ui-kbd keys=\"esc\"></ui-kbd>"
    },
    {
      "id": "shortcut",
      "label": "A shortcut",
      "subject": "component:kbd",
      "markup": "<ui-kbd keys=\"mod+k\"></ui-kbd>"
    },
    {
      "id": "mac",
      "label": "One platform's notation",
      "subject": "component:kbd",
      "markup": "<ui-kbd keys=\"mod+shift+p\" platform=\"mac\"></ui-kbd><ui-kbd keys=\"mod+shift+p\" platform=\"other\"></ui-kbd>"
    },
    {
      "id": "in-text",
      "label": "In running text",
      "subject": "component:kbd",
      "markup": "<span>Press <ui-kbd keys=\"mod+s\"></ui-kbd> to save.</span>"
    }
  ]
}
