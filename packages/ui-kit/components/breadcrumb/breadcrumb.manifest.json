      "to": "context:card"
    },
    {
      "from": "component:breadcrumb",
      "relation": "allowedIn",
      "to": "context:collection"
    },
    {
      "from": "component:breadcrumb",
      "relation": "allowedIn",
      "to": "context:group"
    },
    {
      "from": "component:breadcrumb",
      "relation": "allowedIn",
      "to": "context:form"
    },
    {
      "from": "component:breadcrumb",
      "relation": "allowedIn",
      "to": "context:inline"
    },
    {
      "from": "component:breadcrumb",
      "relation": "ownsPart",
      "to": "part:breadcrumb-list"
    },
    {
      "from": "component:breadcrumb",
      "relation": "ownsPart",
      "to": "part:breadcrumb-item"
    },
    {
      "from": "component:breadcrumb",
      "relation": "ownsPart",
      "to": "part:breadcrumb-link"
    },
    {
      "from": "component:breadcrumb",
      "relation": "ownsPart",
      "to": "part:breadcrumb-separator"
    },
    {
      "from": "component:breadcrumb",
      "relation": "ownsPart",
      "to": "part:breadcrumb-ellipsis"
    }
  ],
  "renderers": {
    "webComponent": {
      "status": "completed",
      "module": "./breadcrumb.element.ts",
      "exports": {
        "component:breadcrumb": "UIBreadcrumb"
      },
      "verification": "./verification/breadcrumb.verification.json#/renderers/webComponent"
    },
    "react": {
      "status": "completed",
      "module": "./breadcrumb.react.tsx",
      "exports": {
        "component:breadcrumb": "Breadcrumb"
      },
      "verification": "./verification/breadcrumb.verification.json#/renderers/react",
      "props": {
        "component:breadcrumb": {
          "inherits": [
            "HTMLAttributes<HTMLElement>"
          ],
          "props": [
            "label?: string = 'Breadcrumb' // The accessible name of the navigation. Default \"Breadcrumb\".",
            "maxItems?: number = 0 // Show at most this many crumbs: the root, the ellipsis's folded middle and the last ones.",
            "size?: number // Unit u in px for this element.",
            "children?: ReactNode"
          ]
        }
      }
    }
  }
}
