      "to": "geometry:breadcrumb"
    },
    {
      "from": "component:breadcrumb",
      "relation": "usesTokens",
      "to": "tokens:color-roles"
    },
    {
      "from": "component:breadcrumb",
      "relation": "usesTokens",
      "to": "tokens:geometry"
    },
    {
