{
  "$schema": "../../contracts/component-manifest.schema.json",
  "schemaVersion": 1,
  "name": "breadcrumb",
  "primary": "component:breadcrumb",
  "module": "./breadcrumb.element.ts",
  "registration": "on-import",
  "documentation": "./breadcrumb.md",
  "examples": "./breadcrumb.examples.json",
  "contract": "../../contracts/components.json#/components/breadcrumb",
  "stateContract": "../../contracts/states.json",
  "styleSource": {
    "format": "panda-slot-recipe",
    "module": "./breadcrumb.recipe.ts"
  },
  "nodes": [
    {
      "id": "component:breadcrumb",
      "kind": "component",
      "status": "implemented",
      "tag": "ui-breadcrumb",
      "class": "UIBreadcrumb",
      "extends": "UIElement",
      "intent": [
        "Show where a page sits and link to its ancestors"
      ],
      "properties": [
        {
          "key": "label",
          "type": "string",
          "default": "Breadcrumb",
          "attribute": "label",
          "reflects": false,
          "inspector": {
            "control": "text"
          }
        },
        {
          "key": "maxItems",
          "type": "number",
          "default": 0,
          "attribute": "max-items",
          "reflects": false,
          "inspector": {
            "control": "number"
          }
        }
      ],
      "attributes": [],
      "events": [],
      "semantics": {
        "role": "navigation",
        "formAssociated": false,
        "keyboard": [
          {
            "keys": "Enter or Space on the ellipsis",
            "action": "show every crumb and focus the first revealed"
          }
        ],
        "accessibleName": {
          "sources": [
            "label"
          ],
          "required": false
        }
      },
      "content": {
        "ownership": "consumer",
        "acceptsChildren": true,
        "children": "Crumbs, root first: links, then the current page as text."
      },
      "layout": {
        "display": "block",
        "sizing": "fill"
      },
      "constraints": [
        "The last crumb is the current page.",
        "max-items keeps the root and the end, and folds the middle behind an ellipsis.",
        "The web tag needs the kit's icons for its carets."
      ],
      "avoidWhen": [
        {
          "when": "Moving between sections at one level.",
          "reason": "A breadcrumb shows ancestry, not siblings.",
          "useInstead": "component:tabs"
        },
        {
          "when": "The main site navigation.",
          "reason": "A breadcrumb only shows the path to this page.",
          "useInstead": "component:navigation-menu"
        }
      ],
      "searchTerms": [
        "breadcrumb",
        "breadcrumbs",
        "trail",
        "path",
        "ancestors",
        "navigation trail"
      ]
    },
    {
      "id": "part:breadcrumb-list",
      "kind": "part",
      "status": "implemented",
      "tag": "span",
      "selector": ":scope > [data-part=list]",
      "summary": "The ordered list of crumbs."
    },
    {
      "id": "part:breadcrumb-item",
      "kind": "part",
      "status": "implemented",
      "tag": "span",
      "selector": ":scope > [data-part=list] > [data-part=item]",
      "summary": "One crumb and its caret."
    },
    {
      "id": "part:breadcrumb-link",
      "kind": "part",
      "status": "implemented",
      "tag": "span",
      "selector": ":scope > [data-part=list] > [data-part=item] > [data-part=link]",
      "summary": "An authored crumb."
    },
    {
      "id": "part:breadcrumb-separator",
      "kind": "part",
      "status": "implemented",
      "tag": "span",
      "selector": ":scope > [data-part=list] > [data-part=item] > [data-part=separator]",
      "summary": "The decorative caret."
    },
    {
      "id": "part:breadcrumb-ellipsis",
      "kind": "part",
      "status": "implemented",
      "tag": "span",
      "selector": ":scope > [data-part=list] > [data-part=item] > [data-part=ellipsis]",
      "summary": "The button that shows folded crumbs."
    }
  ],
  "edges": [
    {
      "from": "component:breadcrumb",
      "relation": "extends",
      "to": "foundation:element"
    },
    {
      "from": "component:breadcrumb",
