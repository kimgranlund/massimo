        }
      },
      "content": {
        "ownership": "component",
        "acceptsChildren": false,
        "children": "None: the attributes hold the content."
      },
      "layout": {
        "display": "block",
        "sizing": "fill"
      },
      "constraints": [
        "tone is stated by the author; the delta's sign never sets it.",
        "Empty parts are left out.",
        "The trend has no axes: it shows direction, and its description states the first and last values."
      ],
      "avoidWhen": [
        {
          "when": "The exact values over time matter.",
          "reason": "A trend has no axes or points.",
          "useInstead": "component:data-list"
        }
      ],
      "searchTerms": [
        "stat",
        "stat card",
        "metric",
        "kpi",
        "sparkline",
        "delta",
        "number card"
      ]
