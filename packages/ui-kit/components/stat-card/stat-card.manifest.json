    },
    {
      "id": "part:stat-card-value",
      "kind": "part",
      "status": "implemented",
      "tag": "span",
      "selector": ":scope [data-part=value]",
      "summary": "The metric."
    },
    {
      "id": "part:stat-card-delta",
      "kind": "part",
      "status": "implemented",
      "tag": "span",
      "selector": ":scope [data-part=value] > [data-part=delta]",
      "summary": "The change, on the value's baseline."
    },
    {
      "id": "part:stat-card-comparison",
      "kind": "part",
      "status": "implemented",
      "tag": "span",
      "selector": ":scope [data-part=comparison]",
