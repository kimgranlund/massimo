  "renderers": {
    "webComponent": {
      "status": "completed",
      "module": "./textarea.element.ts",
      "exports": {
        "component:textarea": "UITextarea"
      },
      "verification": "./verification/textarea.verification.json#/renderers/webComponent"
    },
    "react": {
      "status": "completed",
      "module": "./textarea.react.tsx",
      "exports": {
        "component:textarea": "Textarea"
      },
      "verification": "./verification/textarea.verification.json#/renderers/react",
      "props": {
        "component:textarea": {
          "inherits": [
            "Omit<TextareaHTMLAttributes<HTMLTextAreaElement>, 'prefix' | 'className' | 'children'>"
          ],
          "props": [
            "label?: string",
            "hideLabel?: boolean // Keep the label as the accessible name but do not draw it.",
            "leading?: ReactNode",
            "trailing?: ReactNode",
            "description?: string",
            "error?: string",
            "rows?: number = TEXTAREA_ROWS // The rows to hold before the text grows the field. Default 3.",
            "onValueChange?: (value: string, details: ChangeDetails) => void // The text changed (Base UI onValueChange; reason 'none'). The native onChange still fires.",
            "className?: string"
          ]
        }
      }
    },
    "html": {
      "status": "in_progress",
      "selectors": {
        "component:textarea": ".ui-input__root",
        "part:textarea-control": ".ui-input__control"
      }
    }
