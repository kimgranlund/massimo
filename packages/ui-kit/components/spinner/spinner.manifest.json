      "props": {
        "component:spinner": {
          "inherits": [
            "HTMLAttributes<HTMLSpanElement>"
          ],
          "props": [
            "label?: string = '' // The visible text and accessible name. With none, the ring stands alone, named \"Loading\".",
            "hideLabel?: boolean = false // Keep the label as the accessible name without showing it.",
            "size?: number // Unit u in px for this element."
          ]
        }
