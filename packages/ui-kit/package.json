    "prepare": "panda codegen",
    "codegen": "panda codegen",
    "css": "panda cssgen --outfile dist/ui-kit.css && panda cssgen --splitting --outdir dist/split",
    "build": "panda codegen && panda cssgen --outfile dist/ui-kit.css && panda cssgen --splitting --outdir dist/split",
    "typecheck": "tsc -p .",
    "test": "node --test test/",
    "geometry:csv": "node scripts/geometry-csv.ts",
    "tokens:dtcg": "node scripts/tokens-dtcg.ts",
    "theme:schema": "node scripts/theme-schema.ts",
    "brand:schema": "node scripts/brand.ts schema",
