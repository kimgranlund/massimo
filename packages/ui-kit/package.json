{
  "name": "@massimo/ui-kit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Tiny light-DOM web components and React components on one headless layer, styled with PandaCSS.",
  "exports": {
    "./core": "./core/index.ts",
    "./dom": "./dom/index.ts",
    "./tokens": "./tokens/index.ts",
    "./format": "./tokens/typography/format.ts",
    "./styles": "./styles/index.ts",
    "./preset": "./preset.ts",
    "./styled-system/*": "./styled-system/*",
    "./css": "./dist/ui-kit.css",
    "./css/split/*": "./dist/split/*",
    "./components/button/element": "./components/button/button.element.ts",
    "./components/button/react": "./components/button/button.react.tsx",
    "./components/input/element": "./components/input/input.element.ts",
    "./components/input/react": "./components/input/input.react.tsx",
    "./components/listbox/element": "./components/listbox/listbox.element.ts",
    "./components/select/element": "./components/select/select.element.ts",
    "./icons": "./icons/index.ts",
    "./components/btg/element": "./components/btg/btg.element.ts",
    "./components/choice/element": "./components/choice/choice.element.ts",
    "./components/range/element": "./components/range/range.element.ts",
    "./components/color/element": "./components/color/color.element.ts",
    "./components/swiper/element": "./components/swiper/swiper.element.ts",
    "./components/image/element": "./components/image/image.element.ts",
    "./spectrum": "./tokens/colors/spectrum/index.ts",
    "./dtcg/*": "./tokens/dtcg/*",
    "./components/choice/react": "./components/choice/choice.react.tsx",
    "./components/range/react": "./components/range/range.react.tsx",
    "./components/btg/react": "./components/btg/btg.react.tsx",
    "./components/color/react": "./components/color/color.react.tsx",
    "./components/image/react": "./components/image/image.react.tsx",
    "./components/container/react": "./components/container/container.react.tsx",
    "./components/listbox/react": "./components/listbox/listbox.react.tsx",
    "./components/swiper/react": "./components/swiper/swiper.react.tsx",
    "./components/select/react": "./components/select/select.react.tsx",
    "./components/field/element": "./components/field/field.element.ts",
    "./components/field/react": "./components/field/field.react.tsx",
    "./components/separator/element": "./components/separator/separator.element.ts",
    "./components/separator/react": "./components/separator/separator.react.tsx",
    "./components/avatar/element": "./components/avatar/avatar.element.ts",
    "./components/avatar/react": "./components/avatar/avatar.react.tsx",
    "./components/meter/element": "./components/meter/meter.element.ts",
    "./components/meter/react": "./components/meter/meter.react.tsx",
    "./components/toggle/element": "./components/toggle/toggle.element.ts",
    "./components/toggle/react": "./components/toggle/toggle.react.tsx",
    "./components/radio-group/element": "./components/radio-group/radio-group.element.ts",
    "./components/radio-group/react": "./components/radio-group/radio-group.react.tsx",
    "./components/checkbox-group/element": "./components/checkbox-group/checkbox-group.element.ts",
    "./components/checkbox-group/react": "./components/checkbox-group/checkbox-group.react.tsx",
    "./components/fieldset/element": "./components/fieldset/fieldset.element.ts",
    "./components/fieldset/react": "./components/fieldset/fieldset.react.tsx",
    "./components/collapsible/element": "./components/collapsible/collapsible.element.ts",
    "./components/collapsible/react": "./components/collapsible/collapsible.react.tsx",
    "./components/accordion/element": "./components/accordion/accordion.element.ts",
    "./components/accordion/react": "./components/accordion/accordion.react.tsx",
    "./components/tabs/element": "./components/tabs/tabs.element.ts",
    "./components/tabs/react": "./components/tabs/tabs.react.tsx",
    "./components/form/element": "./components/form/form.element.ts",
    "./components/form/react": "./components/form/form.react.tsx",
    "./components/scroll-area/element": "./components/scroll-area/scroll-area.element.ts",
    "./components/scroll-area/react": "./components/scroll-area/scroll-area.react.tsx"
  },
  "scripts": {
    "prepare": "panda codegen",
    "codegen": "panda codegen",
    "css": "panda cssgen --outfile dist/ui-kit.css && panda cssgen --splitting --outdir dist/split",
    "build": "panda codegen && panda cssgen --outfile dist/ui-kit.css && panda cssgen --splitting --outdir dist/split",
    "typecheck": "tsc -p .",
    "test": "node --test test/",
    "geometry:csv": "node scripts/geometry-csv.ts",
    "tokens:dtcg": "node scripts/tokens-dtcg.ts",
    "spectrum:defaults": "node scripts/spectrum-defaults.ts",
    "registry": "node scripts/registry.ts",
    "manifests": "node scripts/manifests.ts",
    "registry:graph": "node scripts/registry-graph.ts",
    "verification": "node scripts/verification.ts"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "acorn": "^8.19.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.5"
  }
}
