{
  "name": "@massimo/ui-kit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Tiny light-DOM web components and React components on one headless layer, styled with PandaCSS.",
  "exports": {
    "./core": "./core/index.ts",
    "./dom": "./dom/index.ts",
    "./tokens": "./tokens/index.ts",
    "./styles": "./styles/index.ts",
    "./preset": "./preset.ts",
    "./styled-system/*": "./styled-system/*",
    "./css": "./dist/ui-kit.css",
    "./components/button/element": "./components/button/button.element.ts",
    "./components/button/react": "./components/button/button.react.tsx",
    "./components/input/element": "./components/input/input.element.ts",
    "./components/input/react": "./components/input/input.react.tsx",
    "./components/listbox/element": "./components/listbox/listbox.element.ts",
    "./components/select/element": "./components/select/select.element.ts"
  },
  "scripts": {
    "prepare": "panda codegen",
    "codegen": "panda codegen",
    "css": "panda cssgen --outfile dist/ui-kit.css",
    "build": "panda codegen && panda cssgen --outfile dist/ui-kit.css",
    "typecheck": "tsc -p .",
    "test": "node --test test/"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
