{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://massimo.dev/schemas/examples.schema.json",
  "title": "massimo component examples",
  "description": "Runnable markup per component folder. Every example mounts in the tests with no native form elements; subject names the graph node it demonstrates.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "component", "title", "summary", "defaultExample", "examples"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "component": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$", "description": "The component folder." },
    "title": { "type": "string" },
    "summary": { "type": "string" },
    "defaultExample": { "type": "string" },
    "examples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "subject", "markup"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "label": { "type": "string" },
          "subject": { "type": "string", "pattern": "^(component|part):[a-z][a-z0-9-]*$" },
          "markup": { "type": "string", "minLength": 1 },
          "note": { "type": "string" }
        }
      }
    }
  }
}
