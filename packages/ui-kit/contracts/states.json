  "native": {
    "disabled": "A React native control (input, select) disabled by an ancestor <fieldset disabled> is :disabled without React knowing: _disabled / _enabled and the select and input control rules keep :disabled beside data-disabled.",
    "React Select open": "select:open: the browser owns the customizable select's picker and fires no open or close event.",
    "React Select options": ":checked (selected) and :focus (highlighted) on the native <option>s, and ::picker(select) for the popup (a pseudo-element takes no attributes); data-placeholder has no React counterpart (a native select always shows an option).",
    "React field validity": "The React hosts read the native control's validity (constraint validation) when they set data-valid / data-invalid; :user-invalid is not used, so both renderers show errors at the same moment (blur or a blocked submit)."
  },
  "states": {
    "hover-press": {
      "hook": ":hover / :active on _enabled controls (not data-disabled, not data-busy)",
      "look": "neutral fill steps 3 → 4 → 5; solids primary.solidHover; selected options primary.subtleHover",
      "components": [
        "ui-button",
        "ui-toggle",
        "ui-chip",
        "ui-option",
        "ui-input",
        "ui-select",
        "ui-checkbox",
        "ui-radio",
        "ui-switch",
        "ui-range",
        "ui-palette",
        "ui-collapsible",
        "ui-accordion",
        "ui-menu"
      ]
    },
    "keyboard-focus": {
      "hook": ":focus-visible after key use (html[data-modality=keyboard])",
      "look": "2px focus-ring outline; text fields keep it after a pointer click",
      "components": [
        "ui-button",
        "ui-toggle",
        "ui-chip",
        "ui-input",
        "ui-select",
        "ui-listbox",
        "ui-segmented",
        "ui-checkbox",
        "ui-radio",
        "ui-switch",
        "ui-range",
        "ui-palette",
        "ui-swiper",
        "ui-collapsible",
        "ui-accordion",
        "ui-tabs",
        "ui-menu"
      ]
    },
    "highlighted": {
      "hook": "[data-highlighted]",
      "look": "neutral fill (options); focus-ring outline under keyboard modality (swatches)",
      "components": [
        "ui-option",
        "ui-swatch",
        "ui-menu"
      ]
    },
    "selected": {
      "hook": "[data-checked], [data-selected], [data-pressed]",
      "look": "primary solid (choices, chips) or primary subtle (select options); listbox and segmented: bg.selected; swiper: the stretched dot; tabs [data-active]: the indicator under the active tab (segmented bg.selected, underline a primary bar)",
      "components": [
        "ui-option",
        "ui-checkbox",
        "ui-radio",
        "ui-switch",
        "ui-chip",
        "ui-swatch",
        "ui-swiper",
        "ui-tabs",
        "ui-menu"
      ]
    },
    "open": {
      "hook": "trigger [data-popup-open]; popup [data-open]",
      "look": "pressed fill, chevron turned 180° (collapsible: trigger [data-panel-open], panel [data-open]; caret turned 180°, the panel's height grows from 0 on the reveal intent)",
      "components": [
        "ui-select",
        "ui-collapsible",
        "ui-accordion",
        "ui-menu",
        "ui-context-menu"
      ]
    },
    "disabled": {
      "hook": "[data-disabled] on host, option or paddle",
      "look": "50% opacity, not-allowed cursor (a disabled tab 45%)",
      "components": [
        "ui-button",
        "ui-chip",
        "ui-option",
        "ui-input",
        "ui-select",
        "ui-listbox",
        "ui-segmented",
        "ui-checkbox",
        "ui-radio",
        "ui-switch",
        "ui-range",
        "ui-palette",
        "ui-field",
        "ui-collapsible",
        "ui-accordion",
        "ui-tabs",
        "ui-menu",
        "ui-context-menu"
      ]
    },
    "busy": {
      "hook": "[data-busy]",
      "look": "readable, progress cursor, indeterminate sweep on the bottom edge",
      "components": [
        "ui-button"
      ]
    },
    "read-only": {
      "hook": "[data-readonly]",
      "look": "subtle fill, default cursor",
      "components": [
        "ui-input"
      ]
    },
    "required": {
      "hook": "[data-required]",
      "look": " * in critical.fg after the label",
      "components": [
        "ui-input",
        "ui-select",
        "ui-checkbox",
        "ui-switch",
        "ui-field"
      ]
    },
    "invalid": {
      "hook": "[data-invalid] (shown after blur or a blocked submit; an author error at once)",
      "look": "critical-tinted fill (palette: critical outline)",
      "components": [
        "ui-input",
        "ui-select",
        "ui-listbox",
        "ui-segmented",
        "ui-checkbox",
        "ui-radio",
        "ui-switch",
        "ui-palette"
      ]
    },
    "dragging": {
      "hook": "[data-dragging]",
      "look": "grabbing cursor, raised thumb; thumb and fill track the pointer 1:1",
      "components": [
        "ui-range"
      ]
    },
    "placeholder": {
      "hook": "trigger [data-placeholder]; :empty editor",
      "look": "fg.subtle",
      "components": [
        "ui-select",
        "ui-input"
      ]
    },
    "indeterminate": {
      "hook": "[data-indeterminate]",
      "look": "sweep (progress), minus mark (checkbox); a faint full fill under reduced motion",
      "components": [
        "ui-progress",
        "ui-checkbox"
      ]
    },
    "unparsable-color": {
      "hook": "[data-invalid] (swatch)",
      "look": "critical strike",
      "components": [
        "ui-swatch"
      ]
    },
    "translucent-color": {
      "hook": "[data-alpha] (swatch)",
      "look": "checkerboard under the color",
      "components": [
        "ui-swatch"
      ]
    },
    "failed-image": {
      "hook": "img[data-error]",
      "look": "hidden; the frame's empty fill remains",
      "components": [
        "ui-image"
      ]
    },
    "single-slide": {
      "hook": "[data-single] (swiper)",
      "look": "paddles and dots hidden",
      "components": [
        "ui-swiper"
      ]
    },
    "forced-colors": {
      "hook": "@media (forced-colors: active)",
      "look": "1px CanvasText outline, Highlight for on states, GrayText disabled",
      "components": [
        "*"
      ]
    },
    "reduced-motion": {
      "hook": "@media (prefers-reduced-motion: reduce)",
      "look": "every duration collapses; sweeps become static fills",
      "components": [
        "*"
      ]
    }
  }
}
