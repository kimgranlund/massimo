{
  "schemaVersion": 2,
  "notation": "Every state a component sets is a data-* presence attribute (Base UI names, https://base-ui.com) on the same host or part in both renderers; styles key on it, never on a class. ARIA stays for semantics. The web components set the attributes in update() (UIFormElement sets the field state); the React renderers set them as props from React state (components/state.react.ts). The Panda conditions (styles/conditions.ts) key on them; each slot recipe (components/<name>/<name>.recipe.ts) styles its states with them. `attributes` defines each name (baseUi: true when Base UI uses the same name for the same state; false when it is ours); `components` lists, per element, the attributes on its host and on named parts; `native` lists the states that stay on a native pseudo-class in a React renderer and why; `states` maps each state to its look.",
  "styles": "styles/conditions.ts",
  "behavior": "dom/state.ts",
  "react": "components/state.react.ts",
  "motion": "components/recipe-parts.ts",
  "attributes": {
    "data-disabled": {
      "baseUi": true,
      "condition": "_disabled",
      "meaning": "Disabled: by its own property, an ancestor <fieldset disabled> or ui-fieldset[disabled], a disabled choice group, or (an option) its list."
    },
    "data-readonly": {
      "baseUi": true,
      "condition": "_readOnly",
      "meaning": "Read-only (input)."
    },
    "data-required": {
      "baseUi": true,
      "condition": "_required",
      "meaning": "A value is required."
    },
    "data-valid": {
      "baseUi": true,
      "condition": "_valid",
      "meaning": "Valid, once validity is shown (after the user leaves the control or a submit is blocked)."
    },
    "data-invalid": {
      "baseUi": true,
      "condition": "_invalid",
      "meaning": "Invalid, once shown: after the user leaves the control or a submit is blocked; an author error at once. On ui-swatch: the color does not parse."
    },
    "data-dirty": {
      "baseUi": true,
      "condition": "_dirty",
      "meaning": "The value differs from the initial value."
    },
    "data-touched": {
      "baseUi": true,
      "condition": "_touched",
      "meaning": "The user has left the control once (a choice: also activated it)."
    },
    "data-filled": {
      "baseUi": true,
      "condition": "_filled",
      "meaning": "The value is not empty (a choice: checked)."
    },
    "data-focused": {
      "baseUi": true,
      "condition": "_focused",
      "meaning": "Focus is within the control."
    },
    "data-checked": {
      "baseUi": true,
      "condition": "_checked",
      "meaning": "Checkbox, radio or switch is on."
    },
    "data-unchecked": {
      "baseUi": true,
      "condition": "_unchecked",
      "meaning": "Checkbox, radio or switch is off."
    },
    "data-indeterminate": {
      "baseUi": true,
      "condition": "_indeterminate",
      "meaning": "Checkbox mixed (instead of data-checked / data-unchecked); progress without a value."
    },
    "data-busy": {
      "baseUi": false,
      "condition": "_busy",
      "meaning": "Button loading: activation blocked, label readable (aria-busy for semantics)."
    },
    "data-pressed": {
      "baseUi": true,
      "condition": "_pressed",
      "meaning": "A toggle that is on (ui-toggle and the selectable chip, Base UI Toggle); the select trigger while its popup is open (Base UI Select.Trigger)."
    },
    "data-popup-open": {
      "baseUi": true,
      "condition": "_popupOpen",
      "meaning": "The select trigger's popup is open."
    },
    "data-placeholder": {
      "baseUi": true,
      "condition": null,
      "meaning": "The select trigger and value show the placeholder (no option selected). The ui-input editor's data-placeholder is its placeholder text, not a state."
    },
    "data-open": {
      "baseUi": true,
      "condition": "_open",
      "meaning": "The select popup is open; a collapsible or accordion item (host, header and panel) is open."
    },
    "data-closed": {
      "baseUi": true,
      "condition": "_closed",
      "meaning": "The select popup is closed; a collapsible or accordion item (host and panel) is closed."
    },
    "data-side": {
      "baseUi": true,
      "condition": null,
      "meaning": "The side of the trigger the open popup sits on: bottom or top (anchor positioning may flip it)."
    },
    "data-align": {
      "baseUi": true,
      "condition": null,
      "meaning": "The open popup's alignment to the trigger: start."
    },
    "data-selected": {
      "baseUi": true,
      "condition": "_selected",
      "meaning": "The selected option or swatch; the current slide's dot (swiper; Base UI has no carousel)."
    },
    "data-highlighted": {
      "baseUi": true,
      "condition": "_highlighted",
      "meaning": "The keyboard-highlighted option or swatch (aria-activedescendant); replaces data-active."
    },
    "data-orientation": {
      "baseUi": true,
      "condition": null,
      "meaning": "horizontal or vertical: listbox, segmented, palette, range, separator; accordion (host and panels); tabs (every part)."
    },
    "data-dragging": {
      "baseUi": true,
      "condition": "_dragging",
      "meaning": "A pointer drags the range thumb."
    },
    "data-progressing": {
      "baseUi": true,
      "condition": "_progressing",
      "meaning": "Progress with a value below the max."
    },
    "data-complete": {
      "baseUi": true,
      "condition": "_complete",
      "meaning": "Progress at the max."
    },
    "data-alpha": {
      "baseUi": false,
      "condition": null,
      "meaning": "The swatch color is translucent or missing: a checkerboard shows under it."
    },
    "data-single": {
      "baseUi": false,
      "condition": null,
      "meaning": "The swiper has one slide: no paddles or dots."
    },
    "data-error": {
      "baseUi": false,
      "condition": null,
      "meaning": "On a ui-image img: the image failed to load (the frame's empty fill shows). On an avatar image (Base UI Avatar.Image, the same name): the image failed and the fallback shows."
    },
    "data-loading": {
      "baseUi": true,
      "condition": null,
      "meaning": "On an avatar image (Base UI Avatar.Image): the image is loading; the fallback shows until it loads."
    },
    "data-active": {
      "baseUi": true,
      "condition": null,
      "meaning": "The active tab (Base UI Tabs.Tab; aria-selected for semantics)."
    },
    "data-hidden": {
      "baseUi": true,
      "condition": null,
      "meaning": "A tab panel that is not shown (Base UI Tabs.Panel; also hidden)."
    },
    "data-activation-direction": {
      "baseUi": true,
      "condition": null,
      "meaning": "Where the active tab moved last: left, right, up, down, or none before any change (Base UI Tabs; root, list, tabs, indicator, panels)."
    },
    "data-panel-open": {
      "baseUi": true,
      "condition": null,
      "meaning": "The collapsible trigger's panel is open (Base UI Collapsible.Trigger)."
    }
  },
