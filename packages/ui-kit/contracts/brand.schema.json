{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://massimo.dev/contracts/brand.schema.json",
  "$comment": "Generated by npm run brand:schema from tokens/brand/index.ts, contracts/brand-catalogue.json and the descriptor scales. Do not edit.",
  "title": "Brand",
  "description": "A brand that hydrates a theme (docs/planning/brand-schema.md): its frame (subject, grounding, territories, muse), its closed choices (descriptor values), anchors, faces, voice and signature.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,39}$"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "audience": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "primaryJob": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "kind": {
          "enum": [
            "product",
            "editorial",
            "tool",
            "campaign",
            "institution"
          ]
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          }
        }
      },
      "required": [
        "name",
        "audience",
        "primaryJob",
        "kind",
        "sources"
      ]
    },
    "grounding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "primary": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ref": {
              "enum": [
                "swiss-international",
                "bauhaus",
                "mingei",
                "arts-and-crafts",
                "memphis",
                "brutalism",
                "scandinavian-functionalism",
                "californian-modernism"
              ]
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 400
            },
            "relation": {
              "enum": [
                "inherit",
                "reinterpret",
                "react-against"
              ]
            },
            "principles": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 400
              }
            }
          },
          "required": [
            "relation"
          ]
        },
        "secondary": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ref": {
              "enum": [
                "swiss-international",
                "bauhaus",
                "mingei",
                "arts-and-crafts",
                "memphis",
                "brutalism",
                "scandinavian-functionalism",
                "californian-modernism"
              ]
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 400
            },
            "relation": {
              "enum": [
                "inherit",
                "reinterpret",
                "react-against"
              ]
            },
            "principles": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 400
              }
            }
          },
          "required": [
            "relation"
          ]
        }
      },
      "required": [
        "primary"
      ]
    },
    "territories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          },
          "ref": {
            "enum": [
              "harbor",
              "workshop",
              "botanical",
              "nocturne",
              "archive",
              "laboratory",
              "desert"
            ]
          },
          "primary": {
            "type": "boolean"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "materials": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 400
            }
          },
          "palette": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 400
                },
                "value": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                }
              },
              "required": [
                "name",
                "value"
              ]
            }
          },
          "textures": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          },
          "light": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          },
          "composition": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          },
          "type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          },
          "motion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          },
          "imagery": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          },
          "outOfBounds": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "<scale>.<value> or free text"
            }
          },
          "character": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "scale": {
                "enum": [
                  "xs",
                  "sm",
                  "md",
                  "lg",
                  "xl"
                ],
                "description": "Scale: how big everything is"
              },
              "density": {
                "enum": [
                  "compact",
                  "default",
                  "loose"
                ],
                "description": "Density: how much fits at the same scale"
              },
              "space": {
                "enum": [
                  "tight",
                  "balanced",
                  "airy"
                ],
                "description": "Space: margins and gutters: container padding and gaps"
              },
              "curvature": {
                "enum": [
                  "square",
                  "crisp",
                  "soft",
                  "round",
                  "pill"
                ],
                "description": "Curvature: how round corners are"
              },
              "corner": {
                "enum": [
                  "bevel",
                  "round",
                  "squircle"
                ],
                "description": "Corner shape: the curve of a corner"
              },
              "line": {
                "enum": [
                  "borderless",
                  "hairline",
                  "outlined"
                ],
                "description": "Line: how much outline controls carry"
              },
              "elevation": {
                "enum": [
                  "flat",
                  "layered",
                  "floating"
                ],
                "description": "Elevation: how surfaces separate"
              },
              "type-scale": {
                "enum": [
                  "flat",
                  "gentle",
                  "classic",
                  "dramatic"
                ],
                "description": "Type scale: how far headings step from body text"
              },
              "iconography": {
                "enum": [
                  "phosphor",
                  "lucide",
                  "tabler"
                ],
                "description": "Iconography: the icon set and its drawing"
              },
              "vibrancy": {
                "enum": [
                  "muted",
                  "natural",
                  "vivid"
                ],
                "description": "Vibrancy: how saturated the palette is"
              },
              "harmony": {
                "enum": [
                  "unique",
                  "analogous",
                  "complementary",
                  "split",
                  "triadic"
                ],
                "description": "Harmony: how accent hues relate"
              },
              "neutral": {
                "enum": [
                  "true",
                  "subtle",
                  "tinted",
                  "strong"
                ],
                "description": "Neutral: how much the neutrals carry the hue"
              },
              "adaptivity": {
                "enum": [
                  "both",
                  "light-first",
                  "dark-first"
                ],
                "description": "Adaptivity: which scheme the theme leads with"
              },
              "emphasis": {
                "enum": [
                  "quiet",
                  "balanced",
                  "loud"
                ],
                "description": "Emphasis: how strongly a selection shows"
              },
              "movement": {
                "enum": [
                  "still",
                  "calm",
                  "lively",
                  "playful"
                ],
                "description": "Movement: how things move"
              }
            }
          }
        },
        "required": [
          "name",
          "description"
        ]
      }
    },
    "muse": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "person",
            "work",
            "object",
            "place",
            "archetype"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "take": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "leave": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        }
      },
      "required": [
        "kind",
        "name",
        "take"
      ]
    },
    "color": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "anchors": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 400
              },
              "value": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "role": {
                "enum": [
                  "primary",
                  "secondary",
                  "neutral",
                  "critical",
                  "warning",
                  "success",
                  "info",
                  "data1",
                  "data2",
                  "data3",
                  "data4",
                  "data5",
                  "data6"
                ]
              },
              "step": {
                "type": "integer",
                "minimum": 2,
                "maximum": 12
              },
              "dark": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              }
            },
            "required": [
              "name",
              "value",
              "role"
            ]
          }
        },
        "feedback": {
          "enum": [
            "independent",
            "anchored"
          ]
        },
        "character": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "vibrancy": {
              "enum": [
                "muted",
                "natural",
                "vivid"
              ],
              "description": "Vibrancy: how saturated the palette is"
            },
            "harmony": {
              "enum": [
                "unique",
                "analogous",
                "complementary",
                "split",
                "triadic"
              ],
              "description": "Harmony: how accent hues relate"
            },
            "neutral": {
              "enum": [
                "true",
                "subtle",
                "tinted",
                "strong"
              ],
              "description": "Neutral: how much the neutrals carry the hue"
            },
            "emphasis": {
              "enum": [
                "quiet",
                "balanced",
                "loud"
              ],
              "description": "Emphasis: how strongly a selection shows"
            }
          }
        }
      }
    },
    "type": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "faces": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "display": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "ref": {
                  "enum": [
                    "helvetica-neue",
                    "system-ui",
                    "avenir-next",
                    "futura",
                    "gill-sans",
                    "georgia",
                    "charter",
                    "baskerville",
                    "didot",
                    "menlo",
                    "inter",
                    "inter-tight",
                    "ibm-plex-sans",
                    "ibm-plex-mono",
                    "jetbrains-mono",
                    "source-sans-3",
                    "work-sans",
                    "space-grotesk",
                    "manrope",
                    "fraunces",
                    "newsreader",
                    "dm-serif-display",
                    "libre-franklin",
                    "roboto-slab"
                  ],
                  "description": "A face catalogue id; fills family, descriptor and source."
                },
                "family": {
                  "type": "string",
                  "pattern": "^[\\w\\s.-]{1,60}$"
                },
                "descriptor": {
                  "enum": [
                    "neo-grotesque",
                    "geometric",
                    "humanist",
                    "grotesque",
                    "serif",
                    "slab",
                    "mono",
                    "display"
                  ]
                },
                "source": {
                  "enum": [
                    "system",
                    "google",
                    "self-hosted"
                  ]
                },
                "url": {
                  "type": "string",
                  "pattern": "^https://"
                },
                "weights": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 100,
                    "maximum": 900
                  }
                }
              },
              "anyOf": [
                {
                  "required": [
                    "ref"
                  ]
                },
                {
                  "required": [
                    "family",
                    "descriptor"
                  ]
                }
              ]
            },
            "body": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "ref": {
                  "enum": [
                    "helvetica-neue",
                    "system-ui",
                    "avenir-next",
                    "futura",
                    "gill-sans",
                    "georgia",
                    "charter",
                    "baskerville",
                    "didot",
                    "menlo",
                    "inter",
                    "inter-tight",
                    "ibm-plex-sans",
                    "ibm-plex-mono",
                    "jetbrains-mono",
                    "source-sans-3",
                    "work-sans",
                    "space-grotesk",
                    "manrope",
                    "fraunces",
                    "newsreader",
                    "dm-serif-display",
                    "libre-franklin",
                    "roboto-slab"
                  ],
                  "description": "A face catalogue id; fills family, descriptor and source."
                },
                "family": {
                  "type": "string",
                  "pattern": "^[\\w\\s.-]{1,60}$"
                },
                "descriptor": {
                  "enum": [
                    "neo-grotesque",
                    "geometric",
                    "humanist",
                    "grotesque",
                    "serif",
                    "slab",
                    "mono",
                    "display"
                  ]
                },
                "source": {
                  "enum": [
                    "system",
                    "google",
                    "self-hosted"
                  ]
                },
                "url": {
                  "type": "string",
                  "pattern": "^https://"
                },
                "weights": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 100,
                    "maximum": 900
                  }
                }
              },
              "anyOf": [
                {
                  "required": [
                    "ref"
                  ]
                },
                {
                  "required": [
                    "family",
                    "descriptor"
                  ]
                }
              ]
            },
            "utility": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "ref": {
                  "enum": [
                    "helvetica-neue",
                    "system-ui",
                    "avenir-next",
                    "futura",
                    "gill-sans",
                    "georgia",
                    "charter",
                    "baskerville",
                    "didot",
                    "menlo",
                    "inter",
                    "inter-tight",
                    "ibm-plex-sans",
                    "ibm-plex-mono",
                    "jetbrains-mono",
                    "source-sans-3",
                    "work-sans",
                    "space-grotesk",
                    "manrope",
                    "fraunces",
                    "newsreader",
                    "dm-serif-display",
                    "libre-franklin",
                    "roboto-slab"
                  ],
                  "description": "A face catalogue id; fills family, descriptor and source."
                },
                "family": {
                  "type": "string",
                  "pattern": "^[\\w\\s.-]{1,60}$"
                },
                "descriptor": {
                  "enum": [
                    "neo-grotesque",
                    "geometric",
                    "humanist",
                    "grotesque",
                    "serif",
                    "slab",
                    "mono",
                    "display"
                  ]
                },
                "source": {
                  "enum": [
                    "system",
                    "google",
                    "self-hosted"
                  ]
                },
                "url": {
                  "type": "string",
                  "pattern": "^https://"
                },
                "weights": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 100,
                    "maximum": 900
                  }
                }
              },
              "anyOf": [
                {
                  "required": [
                    "ref"
                  ]
                },
                {
                  "required": [
                    "family",
                    "descriptor"
                  ]
                }
              ]
            }
          }
        },
        "character": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type-scale": {
              "enum": [
                "flat",
                "gentle",
                "classic",
                "dramatic"
              ],
              "description": "Type scale: how far headings step from body text"
            }
          }
        }
      }
    },
    "form": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scale": {
          "enum": [
            "xs",
            "sm",
            "md",
            "lg",
            "xl"
          ],
          "description": "Scale: how big everything is"
        },
        "density": {
          "enum": [
            "compact",
            "default",
            "loose"
          ],
          "description": "Density: how much fits at the same scale"
        },
        "space": {
          "enum": [
            "tight",
            "balanced",
            "airy"
          ],
          "description": "Space: margins and gutters: container padding and gaps"
        },
        "curvature": {
          "enum": [
            "square",
            "crisp",
            "soft",
            "round",
            "pill"
          ],
          "description": "Curvature: how round corners are"
        },
        "corner": {
          "enum": [
            "bevel",
            "round",
            "squircle"
          ],
          "description": "Corner shape: the curve of a corner"
        },
        "line": {
          "enum": [
            "borderless",
            "hairline",
            "outlined"
          ],
          "description": "Line: how much outline controls carry"
        },
        "elevation": {
          "enum": [
            "flat",
            "layered",
            "floating"
          ],
          "description": "Elevation: how surfaces separate"
        }
      }
    },
    "movement": {
      "enum": [
        "still",
        "calm",
        "lively",
        "playful"
      ]
    },
    "adaptivity": {
      "enum": [
        "both",
        "light-first",
        "dark-first"
      ]
    },
    "voice": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tone": {
          "type": "array",
          "items": {
            "enum": [
              "plain",
              "warm",
              "precise",
              "playful",
              "confident",
              "calm",
              "candid",
              "formal",
              "technical",
              "poetic"
            ]
          }
        },
        "samples": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "action": {
              "type": "string",
              "minLength": 1,
              "maxLength": 400
            },
            "confirmation": {
              "type": "string",
              "minLength": 1,
              "maxLength": 400
            },
            "error": {
              "type": "string",
              "minLength": 1,
              "maxLength": 400
            }
          }
        }
      }
    },
    "iconography": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "set": {
          "enum": [
            "phosphor",
            "lucide",
            "tabler"
          ]
        },
        "weight": {
          "enum": [
            "thin",
            "light",
            "regular",
            "bold"
          ]
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "concept": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "scale": {
          "enum": [
            "scale",
            "density",
            "space",
            "curvature",
            "corner",
            "line",
            "elevation",
            "type-scale",
            "iconography",
            "vibrancy",
            "harmony",
            "neutral",
            "adaptivity",
            "emphasis",
            "movement"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        }
      },
      "required": [
        "scale",
        "reason"
      ]
    },
    "avoid": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 400
      }
    },
    "rationale": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 600
      }
    }
  },
  "required": [
    "schemaVersion",
    "name",
    "subject"
  ]
}
