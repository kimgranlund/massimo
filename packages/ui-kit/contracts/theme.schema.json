            },
            "darkTone": {
              "type": "number",
              "minimum": 0,
              "maximum": 20,
              "description": "Dark endpoint"
            },
            "toneMax": {
              "type": "number",
              "minimum": 80,
              "maximum": 100,
              "description": "Light endpoint"
            },
            "ladder": {
