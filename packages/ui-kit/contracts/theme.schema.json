        },
        "surface-contrast": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "multipleOfStep": 0.05,
          "description": "Surface contrast"
        },
        "shadow-raised": {
          "type": "number",
          "minimum": 0,
          "maximum": 24,
          "multipleOfStep": 1,
          "description": "Raised (dp)"
        },
        "shadow-floating": {
          "type": "number",
          "minimum": 0,
          "maximum": 24,
          "multipleOfStep": 1,
          "description": "Floating (dp)"
