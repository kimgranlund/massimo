{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://massimo.dev/contracts/theme.schema.json",
  "$comment": "Generated by npm run theme:schema from tokens/themes/theme.ts and the exports it reads. Do not edit. multipleOfStep is the parameter step (validateThemeObject checks it).",
  "title": "Theme",
  "description": "One theme: overrides of the kit defaults, every section optional (docs/specs/theming.md#theme-object).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,39}$"
    },
    "description": {
      "type": "string"
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "radius-scale": {
          "type": "number",
          "minimum": 0,
          "maximum": 3,
          "multipleOfStep": 0.05,
          "description": "Corner radius"
        },
        "corner-shape": {
          "type": "number",
          "minimum": -1,
          "maximum": 4,
          "multipleOfStep": 0.1,
          "description": "Corner shape"
        },
        "radius-group": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "multipleOfStep": 0.05,
          "description": "Group radius (× concentric)"
        },
        "radius-collection": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "multipleOfStep": 0.05,
