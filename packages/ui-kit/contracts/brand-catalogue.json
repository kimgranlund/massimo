  "$comment": "Curated groundings (heritages, movements, schools) and visual-territory archetypes for the Brand schema (docs/planning/brand-schema.md). Each canon is a set of descriptor values (contracts/domains/*.json descriptors) the entry implies; hydrate uses them below the brand's explicit choices. Sources are general references for the entry, not endorsements.",
  "groundings": [
    {
      "id": "swiss-international",
      "kind": "grounding",
      "title": "Swiss International Style",
      "period": "1950s–1970s",
      "place": "Switzerland",
      "principles": [
        "Objective clarity: content before ornament",
        "The grid organizes everything",
        "Asymmetric layouts with generous white space",
        "Sans-serif type, flush left, ragged right",
        "Photography over illustration"
      ],
      "canon": {
        "character": {
          "curvature": "crisp",
          "line": "borderless",
          "elevation": "flat",
          "space": "airy",
          "type-scale": "dramatic",
          "vibrancy": "natural",
          "neutral": "true",
          "movement": "still"
        },
        "faces": {
          "body": "neo-grotesque",
          "display": "neo-grotesque"
        }
      },
      "cliches": [
        "Helvetica on red, white and black posters by default",
        "Grids shown for their own sake"
      ],
      "sources": [
        "Josef Müller-Brockmann, Grid Systems in Graphic Design (1981)",
        "Richard Hollis, Swiss Graphic Design (2006)"
      ]
    },
