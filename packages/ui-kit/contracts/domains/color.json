{
  "$schema": "../domain-manifest.schema.json",
  "schemaVersion": 1,
  "id": "domain:color",
  "name": "color",
  "title": "Color",
  "summary": "Every color: the color engine generates light and dark 12-step ramps (each step placed by an APCA Lc target against the page), the role mapping picks a family per role, and white and black map to neutral steps. Components use roles only.",
  "themePart": "color",
  "concepts": [
    "vibrancy",
    "emphasis",
    "adaptivity"
  ],
  "parameterGroups": [
    "spectrum",
    "roles",
    "emphasis"
  ],
  "constraints": [
    "vibrancy.text-contrast",
    "emphasis.on-solid",
    "vibrancy.anchor-order",
    "vibrancy.anchor-range"
  ],
  "descriptors": [
    {
      "id": "vibrancy",
      "concept": "vibrancy",
      "title": "Vibrancy",
      "reads": "how saturated the palette is",
      "default": "vivid",
      "inputs": [
        "spectrum.chroma",
        "spectrum.base"
      ],
      "values": [
        {
          "name": "muted",
          "set": {
            "spectrum.chroma": 40,
            "spectrum.base": 60
          },
          "means": "low chroma, greyed accents"
        },
        {
          "name": "natural",
          "set": {
            "spectrum.chroma": 80,
            "spectrum.base": 80
          },
          "means": "moderate chroma"
        },
        {
          "name": "vivid",
          "set": {
            "spectrum.chroma": 120,
            "spectrum.base": 100
          },
          "means": "full chroma the gamut allows (the default)"
        }
      ]
    },
    {
      "id": "harmony",
      "concept": "vibrancy",
      "title": "Harmony",
      "reads": "how accent hues relate",
      "default": "unique",
      "inputs": [
        "spectrum.harmony"
      ],
      "values": [
        {
          "name": "unique",
          "set": {
            "spectrum.harmony": "off"
          },
          "means": "evenly spread unique hues (the default)"
        },
        {
          "name": "analogous",
          "set": {
            "spectrum.harmony": "analogous"
          },
          "means": "neighboring hues"
        },
        {
          "name": "complementary",
          "set": {
            "spectrum.harmony": "complementary"
          },
          "means": "opposite hues"
        },
        {
          "name": "split",
          "set": {
            "spectrum.harmony": "split"
          },
          "means": "split complementary"
        },
        {
          "name": "triadic",
          "set": {
            "spectrum.harmony": "triadic"
          },
          "means": "three evenly spaced hues"
        }
      ]
    },
    {
      "id": "neutral",
      "concept": "vibrancy",
      "title": "Neutral",
      "reads": "how much the neutrals carry the hue",
      "default": "tinted",
      "inputs": [
        "spectrum.mat",
        "spectrum.tint"
      ],
      "values": [
        {
          "name": "true",
          "set": {
            "spectrum.mat": "tinted",
            "spectrum.tint": 0
          },
          "means": "true grey neutrals"
        },
        {
          "name": "subtle",
          "set": {
            "spectrum.mat": "tinted",
            "spectrum.tint": 30
          },
          "means": "a hint of the hue"
        },
        {
          "name": "tinted",
          "set": {
            "spectrum.mat": "tinted",
            "spectrum.tint": 75
          },
          "means": "neutrals lean toward the hue (the default)"
        },
        {
          "name": "strong",
          "set": {
            "spectrum.mat": "tinted",
            "spectrum.tint": 100
          },
          "means": "neutrals fully tinted"
        }
      ]
    },
    {
      "id": "adaptivity",
      "concept": "adaptivity",
      "title": "Adaptivity",
      "reads": "which scheme the theme leads with",
      "default": "both",
      "inputs": [
        "scheme"
      ],
      "values": [
        {
          "name": "both",
          "set": {
            "scheme": "auto"
          },
          "means": "follows the OS (the default)"
        },
        {
          "name": "light-first",
          "set": {
            "scheme": "light"
          },
          "means": "light unless the reader switches"
        },
        {
          "name": "dark-first",
          "set": {
            "scheme": "dark"
          },
          "means": "dark unless the reader switches"
        }
      ]
    },
    {
      "id": "emphasis",
      "concept": "emphasis",
      "title": "Emphasis",
      "reads": "how strongly a selection shows",
      "default": "balanced",
      "inputs": [
        "emphasis"
      ],
      "values": [
        {
          "name": "quiet",
          "set": {
            "emphasis": 0
          },
          "means": "a muted neutral fill; the primary stays for actions"
        },
        {
          "name": "balanced",
          "set": {
            "emphasis": 1
          },
          "means": "the page-tone chip in light, the primary solid in dark (the default)"
        },
        {
          "name": "loud",
          "set": {
            "emphasis": 2
          },
          "means": "a primary tint in light: selection carries the brand"
        }
      ]
    }
  ],
  "specs": [
    "../../../../docs/specs/color.md"
  ],
  "resolvers": [
    "tokens/colors/spectrum/index.ts",
    "tokens/colors/spectrum/contrast.ts",
    "tokens/colors/spectrum/anchors.ts",
    "tokens/colors/spectrum/oklch.ts"
  ],
  "checks": [
    {
      "command": "node --test test/spectrum.test.ts",
      "covers": "generation, contrast targets, roles, endpoints, the legacy migration"
    },
    {
      "command": "node --test test/anchors.test.ts",
      "covers": "brand anchors: exact steps, pinned hue, chroma reach, solid step, lint"
    },
    {
      "command": "node --test test/themes.test.ts",
      "covers": "the theme's color part: schema, validator, migration, lint fixtures"
    },
    {
      "command": "node --test test/descriptors.test.ts",
      "covers": "the color descriptor scales: resolve, read back, defaults, lint"
    }
  ],
  "verification": "./verification/color.verification.json",
  "avoidWhen": [],
  "searchTerms": [
    "adaptivity",
    "analogous",
    "balanced",
    "both",
    "color",
    "complementary",
    "dark-first",
    "emphasis",
    "harmony",
    "light-first",
    "loud",
    "muted",
    "natural",
    "neutral",
    "quiet",
    "split",
    "strong",
    "subtle",
    "tinted",
    "triadic",
    "true",
    "unique",
    "vibrancy",
    "vivid"
  ],
  "themePartFields": [
    "parameters",
    "spectrum",
    "roles",
    "endpoints",
    "anchors"
  ]
}
