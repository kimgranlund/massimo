{
  "$schema": "../domain-manifest.schema.json",
  "schemaVersion": 1,
  "id": "domain:typography",
  "name": "typography",
  "title": "Typography",
  "summary": "How text looks and reads: font faces, the voices that point at them, the type scale (ratio and rhythm on the unit) and each type role's text color. Role sizes derive from 10px + u and the ratio; voices repoint per subtree.",
  "themePart": "typography",
  "concepts": [
    "typography"
  ],
  "parameterGroups": [
    "type-scale",
    "faces",
    "voices"
  ],
  "constraints": [
    "typography.face-weights",
    "typography.web-face-source"
  ],
  "descriptors": [
    {
      "id": "type-scale",
      "concept": "typography",
      "title": "Type scale",
      "reads": "how far headings step from body text",
      "default": "classic",
      "inputs": [
        "type-ratio"
      ],
      "values": [
        {
          "name": "flat",
          "set": {
            "type-ratio": 1.125
          },
          "means": "major second: quiet hierarchy, dense UI"
        },
        {
          "name": "gentle",
          "set": {
            "type-ratio": 1.2
          },
          "means": "minor third"
        },
        {
          "name": "classic",
          "set": {
            "type-ratio": 1.333
          },
          "means": "perfect fourth (the default)"
        },
        {
          "name": "dramatic",
          "set": {
            "type-ratio": 1.5
          },
          "means": "perfect fifth: editorial, display-led"
        }
      ]
    }
  ],
  "specs": [
    "../../../../docs/specs/typography.md"
  ],
  "resolvers": [
    "tokens/typography/resolve.ts",
    "tokens/typography/format.ts",
    "tokens/typography/faces.ts"
  ],
  "checks": [
    {
      "command": "node --test test/typography.test.ts",
      "covers": "type roles, the scale, voices and text colors"
    },
    {
      "command": "node --test test/faces.test.ts",
      "covers": "the face catalogue: entries, voice weights, Google URLs, stacks, lint"
    },
    {
      "command": "node --test test/numeric.test.ts",
      "covers": "formatNumber and the numeric voice"
    },
    {
      "command": "node --test test/themes.test.ts",
      "covers": "the theme's typography part: schema, validator, migration, lint fixtures"
    },
    {
      "command": "node --test test/descriptors.test.ts",
      "covers": "the typography descriptor scales: resolve, read back, defaults, lint"
    }
  ],
  "verification": "./verification/typography.verification.json",
  "avoidWhen": [],
  "searchTerms": [
    "classic",
    "dramatic",
    "flat",
    "gentle",
    "type-scale",
    "typography"
  ],
  "themePartFields": [
    "parameters",
    "sources",
    "faces",
    "voices",
    "colors"
  ]
}
