  "renderers": {
    "resolvers": {
      "checks": [
        {
          "command": "node --test test/motion.test.ts",
          "covers": "springs, easings, intents and the multipliers"
        },
        {
          "command": "node --test test/themes.test.ts",
          "covers": "theme part, migration and lint"
        },
        {
          "command": "node --test test/descriptors.test.ts",
          "covers": "descriptor scales"
        }
      ],
      "latestRun": {
        "date": "2026-11-06",
        "outcome": "pass",
        "commands": [
          "node --test test/motion.test.ts",
          "node --test test/themes.test.ts",
          "node --test test/descriptors.test.ts"
        ],
        "environment": {
          "node": "v26.13.0"
        }
      }
    },
    "browser": {
      "checks": [
        {
          "command": "npm --prefix ../.. run check:browsers",
          "covers": "motion easings: every linear() easing parses and matches the spring in Chromium, Firefox and WebKit"
        }
      ],
      "latestRun": {
        "date": "2026-11-06",
        "outcome": "pass",
        "commands": [
          "npm --prefix ../.. run check:browsers"
        ],
        "environment": {
          "node": "v26.13.0"
        }
      }
    }
  },
  "limitations": [
    "Descriptors cover the closed scales in the manifest; emphasis (role mapping) and iconography have no scale yet."
  ]
}
