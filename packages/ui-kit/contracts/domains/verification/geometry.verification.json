        {
          "command": "node --test test/geometry-acceptance.test.ts",
          "covers": "geometry acceptance cases"
        },
        {
          "command": "node --test test/geometry-csv.test.ts",
          "covers": "docs/geometry.csv is current"
        },
        {
          "command": "node --test test/themes.test.ts",
          "covers": "theme part, migration and lint"
        },
        {
          "command": "node --test test/descriptors.test.ts",
          "covers": "descriptor scales"
        }
      ],
      "latestRun": {
        "date": "2026-11-05",
        "outcome": "pass",
        "commands": [
          "node --test test/geometry.test.ts",
          "node --test test/geometry-acceptance.test.ts",
          "node --test test/geometry-csv.test.ts",
          "node --test test/themes.test.ts",
          "node --test test/descriptors.test.ts"
        ],
        "environment": {
          "node": "v26.13.0"
        }
      }
    },
    "browser": {
      "checks": [
        {
          "command": "npm --prefix ../.. run check:browsers",
          "covers": "geometry-check.html: rendered lengths equal the resolvers in Chromium, Firefox and WebKit"
        }
      ],
      "latestRun": {
        "date": "2026-11-05",
        "outcome": "pass",
        "commands": [
          "npm --prefix ../.. run check:browsers"
        ],
        "environment": {
          "node": "v26.13.0"
        }
      }
    }
  },
  "limitations": [
    "Descriptors cover the closed scales in the manifest; emphasis (role mapping) and iconography have no scale yet."
  ]
