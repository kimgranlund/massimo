        {
          "command": "node --test test/themes.test.ts",
          "covers": "theme part, migration and lint"
        },
        {
          "command": "node --test test/descriptors.test.ts",
          "covers": "descriptor scales"
        }
      ],
      "latestRun": {
        "date": "2026-11-04",
        "outcome": "pass",
        "commands": [
          "node --test test/geometry.test.ts",
          "node --test test/geometry-acceptance.test.ts",
          "node --test test/geometry-csv.test.ts",
          "node --test test/themes.test.ts",
          "node --test test/descriptors.test.ts"
