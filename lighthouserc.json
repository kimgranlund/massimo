{
  "ci": {
    "collect": {
      "startServerCommand": "npm run preview -w @massimo/studio -- --base /massimo/ --port 4319 --strictPort",
      "startServerReadyPattern": "4319",
      "url": [
        "http://localhost:4319/massimo/",
        "http://localhost:4319/massimo/brand-demo.html",
        "http://localhost:4319/massimo/scope-check.html",
        "http://localhost:4319/massimo/docs/"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop",
        "chromeFlags": "--headless=new --no-sandbox"
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": ".*",
          "assertions": {
            "errors-in-console": [
              "error",
              {
                "maxLength": 0
              }
            ],
            "http-status-code": "error",
            "html-has-lang": "error",
            "duplicated-javascript-insight": "error",
            "legacy-javascript-insight": "warn",
            "unused-javascript": "warn",
            "cache-insight": "warn",
            "resource-summary:stylesheet:size": [
              "error",
              {
                "maxNumericValue": 80000
              }
            ],
            "resource-summary:third-party:count": [
              "warn",
              {
                "maxNumericValue": 4
              }
            ],
            "aria-allowed-attr": "error",
            "aria-required-attr": "error",
            "aria-valid-attr": "error",
            "aria-valid-attr-value": "error",
            "aria-roles": "error",
            "aria-input-field-name": "error",
            "aria-toggle-field-name": "error",
            "aria-progressbar-name": "error",
            "aria-meter-name": "error",
            "aria-dialog-name": "error",
            "aria-hidden-focus": "error",
            "button-name": "error",
            "link-name": "error",
            "image-alt": "error",
            "label": "error",
            "heading-order": "error",
            "document-title": "error",
            "duplicate-id-aria": "error",
            "list": "error",
            "listitem": "error",
            "color-contrast": "warn",
            "target-size": "warn"
          }
        },
        {
          "matchingUrlPattern": "/massimo/$",
          "assertions": {
            "resource-summary:script:size": [
              "error",
              {
                "maxNumericValue": 220000
              }
            ],
            "categories:performance": [
              "error",
              {
                "minScore": 0.9
              }
            ],
            "categories:accessibility": [
              "warn",
              {
                "minScore": 0.9
              }
            ],
            "categories:best-practices": [
              "error",
              {
                "minScore": 0.9
              }
            ],
            "largest-contentful-paint": [
              "error",
              {
                "maxNumericValue": 2500
              }
            ],
            "cumulative-layout-shift": [
              "error",
              {
                "maxNumericValue": 0.1
              }
            ],
            "total-blocking-time": [
              "error",
              {
                "maxNumericValue": 200
              }
            ]
          }
        },
        {
          "matchingUrlPattern": "brand-demo",
          "assertions": {
            "resource-summary:script:size": [
              "error",
              {
                "maxNumericValue": 30000
              }
            ],
            "categories:performance": [
              "error",
              {
                "minScore": 0.9
              }
            ],
            "categories:best-practices": [
              "error",
              {
                "minScore": 0.9
              }
            ],
            "largest-contentful-paint": [
              "error",
              {
                "maxNumericValue": 2500
              }
            ],
            "cumulative-layout-shift": [
              "error",
              {
                "maxNumericValue": 0.1
              }
            ]
          }
        },
        {
          "matchingUrlPattern": "scope-check",
          "assertions": {
            "resource-summary:script:size": [
              "error",
              {
                "maxNumericValue": 120000
              }
            ]
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/reports"
    }
  }
}
