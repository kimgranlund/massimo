{
  "$schema": "https://massimo.dev/contracts/theme.schema.json",
  "schemaVersion": 2,
  "name": "massimo",
  "description": "Massimo: see every token's effect live and hand the result off exactly",
  "character": {
    "curvature": "crisp",
    "line": "borderless",
    "elevation": "layered",
    "space": "airy",
    "type-scale": "gentle",
    "vibrancy": "natural",
    "neutral": "subtle",
    "movement": "calm",
    "emphasis": "balanced",
    "adaptivity": "both",
    "iconography": "phosphor"
  },
  "geometry": {
    "parameters": {
      "radius-scale": 0.5,
      "shadow-strength": 1,
      "surface-contrast": 1,
      "shadow-raised": 2,
      "shadow-floating": 8,
      "shadow-modal": 24,
      "card-raised": 0,
      "border": 0,
      "pad-group": 1.5,
      "gap-group": 1.5,
      "pad-collection": 3,
      "gap-collection": 3,
      "pad-card-xs": 3,
      "gap-card-xs": 3,
      "pad-card-sm": 4.5,
      "gap-card-sm": 4.5,
      "pad-card-md": 6,
      "gap-card-md": 6,
      "pad-card-lg": 7.5,
      "gap-card-lg": 7.5,
      "pad-card-xl": 9,
      "gap-card-xl": 9,
      "pad-panel": 9,
      "gap-panel": 9,
      "pad-region": 12,
      "gap-region": 12,
      "pad-page": 12,
      "gap-page": 12
    }
  },
  "motion": {
    "parameters": {
      "motion-scale": 1.25,
      "motion-bounce": 0.25,
      "intent-toggle": 2
    }
  },
  "color": {
    "parameters": {
      "emphasis": 1
    },
    "spectrum": {
      "chroma": 80,
      "base": 80,
      "mat": "tinted",
      "tint": 30
    },
    "anchors": [
      {
        "role": "primary",
        "value": "#2f54c4",
        "name": "drafting blue"
      },
      {
        "role": "secondary",
        "value": "#d9480f",
        "name": "signal orange"
      },
      {
        "role": "neutral",
        "value": "#5c6166",
        "name": "graphite"
      }
    ]
  },
  "typography": {
    "parameters": {
      "type-ratio": 1.2
    },
    "faces": {
      "sans": "\"Inter\", \"Helvetica Neue\", Helvetica, Arial, sans-serif",
      "display": "\"Inter Tight\", \"Helvetica Neue\", Helvetica, Arial, sans-serif",
      "mono": "\"JetBrains Mono\", ui-monospace, Menlo, Consolas, monospace"
    },
    "sources": [
      {
        "family": "Inter",
        "url": "https://fonts.googleapis.com/css2?family=Inter:wght@100..900&display=swap"
      },
