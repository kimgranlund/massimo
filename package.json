{
  "name": "massimo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run studio",
    "build": "npm run ui-kit:build && npm run studio:build && npm run docs:build",
    "preview": "npm run preview -w @massimo/studio",
    "ui-kit:build": "npm run build -w @massimo/ui-kit",
    "ui-kit:test": "npm test -w @massimo/ui-kit",
    "ui-kit:typecheck": "npm run typecheck -w @massimo/ui-kit",
    "studio": "npm run dev -w @massimo/studio",
    "studio:build": "npm run build -w @massimo/studio",
    "docs": "npm run dev -w @massimo/docs",
    "docs:build": "npm run build -w @massimo/docs",
    "registry": "npm run --silent registry -w @massimo/ui-kit --",
    "check:browsers": "node apps/studio/scripts/check-browsers.ts",
    "faces:measure": "node apps/studio/scripts/measure-faces.ts",
    "icons:check": "node apps/studio/scripts/check-icons.ts",
    "brand:studio": "npm run -s brand -w @massimo/ui-kit -- build ../../apps/studio/brand/massimo.brand.json --out ../../apps/studio/public/brand && npm run -s brand -w @massimo/ui-kit -- build ../../apps/studio/brand/massimo.brand.json --out ../../apps/studio/public/brand --scope",
    "lighthouse": "lhci autorun",
    "lighthouse:live": "lhci autorun --config=lighthouserc.live.json"
  },
  "devDependencies": {
    "@lhci/cli": "^0.16.0",
    "@pandacss/dev": "^2.4.0",
    "@pandacss/preset-base": "^2.4.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "happy-dom": "^21.0.4",
    "playwright": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ]
}
